<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WUT Match History</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/card-name-fit.js" defer></script>
</head>
<body>
  <%- include('partials_header') %>
  <%
    const slots = ['F1','F2','D1','D2','G'];
    const cleanName = player => {
      const edition = String(player?.edition || '').trim();
      const name = String(player?.name || '').trim();
      return edition && name.toUpperCase().startsWith(`${edition.toUpperCase()} `) ? name.slice(edition.length).trim() : name;
    };
    const playerName = (match, id) => match.players.find(player => Number(player.id) === Number(id))?.displayName || 'Player';
    const placementFor = (match, userId, slot) => match.placements.find(row => Number(row.user_id) === Number(userId) && row.slot === slot);
    const displayCardFor = (match, row) => {
      if (!row?.card || row.card.matchTeamLogo) return row?.card || null;
      const printedKey = String(row.card_snapshot?.chemistry_key || '');
      const adoptedKey = String(row.journeyman_key_effective || row.journeyman_key || '');
      const target = adoptedKey && adoptedKey !== printedKey ? match.placements.find(item => item.card_snapshot?.chemistry_key === adoptedKey) : null;
      return target?.card?.player?.teamLogo
        ? { ...row.card, matchTeamLogo: target.card.player.teamLogo, matchTeamBgColor: target.card.player.teamBgColor, matchTeamName: target.card_snapshot?.team_name || target.card.player.teamName }
        : row.card;
    };
    const focusedMatch = arena.history.find(match => Number(match.id) === Number(replayMatchId)) || null;
    const draftContext = typeof eventContext === 'undefined' ? null : eventContext;
    const leftUserId = focusedMatch ? Number(currentUser.id) : null;
    const rightUserId = focusedMatch ? Number(focusedMatch.opponent.id) : null;
  %>
  <main class="container cards-page arena-page">
    <section class="card page-title cards-title">
      <div><a class="button-link ghost" href="<%= draftContext ? `/cards/drafts/${draftContext.id}#tournament` : '/cards' %>">← <%= draftContext ? draftContext.name : 'WUT' %></a><p class="eyebrow arena-history-eyebrow"><%= draftContext ? 'Draft Event result' : 'Permanent record' %></p><h1><%= draftContext ? `Tournament Match #${focusedMatch?.id || ''}` : 'Match History' %></h1><p>Review the final score and replay the reveal.</p></div>
      <span class="pill"><%= arena.history.length %> completed</span>
    </section>

    <% if (focusedMatch) { %>
      <section class="card arena-results arena-card-results" id="arena-results" data-reveal-board>
        <div class="arena-results-title"><p class="eyebrow">Match #<%= focusedMatch.id %> result<%= focusedMatch.forfeit_user_id ? ' · timeout forfeit' : '' %></p><h2><%= playerName(focusedMatch, leftUserId) %> vs <%= playerName(focusedMatch, rightUserId) %></h2></div>

        <div class="arena-duel-scoreboard">
          <div class="arena-duel-total is-left"><span><%= playerName(focusedMatch, leftUserId) %></span></div>
          <div class="arena-duel-score-center"><span>Running Score</span><strong><b data-total-for="<%= leftUserId %>" data-final-total="<%= focusedMatch.scores[String(leftUserId)] %>">0</b>–<b data-total-for="<%= rightUserId %>" data-final-total="<%= focusedMatch.scores[String(rightUserId)] %>">0</b></strong></div>
          <div class="arena-duel-total is-right"><span><%= playerName(focusedMatch, rightUserId) %></span></div>
        </div>

        <div class="arena-duel-reveal">
          <% slots.forEach(slot => { %>
            <div class="arena-duel-row">
              <% [leftUserId, rightUserId].forEach(userId => { const row = placementFor(focusedMatch, userId, slot); const isLeft = Number(userId) === leftUserId; %>
                <article class="arena-duel-entry <%= isLeft ? 'is-left' : 'is-right' %> tier-<%= row?.card?.player?.tier || 'common' %>" data-reveal-entry data-user="<%= userId %>">
                  <% if (isLeft && row?.card) { %><div class="arena-duel-card arena-wut-card tier-<%= row.card.player.tier %>"><%- include('partials_wut_card', { card: displayCardFor(focusedMatch, row), statusText: `${row.fp || 0} FP in Match #${focusedMatch.id}` }) %></div><% } %>
                  <div class="arena-duel-scoring">
                    <div class="arena-duel-scoring-head"><span><%= isLeft ? `${slot} · Scoring` : `Scoring · ${slot}` %></span><strong><%= row?.card ? cleanName(row.card.player) : 'Empty' %></strong></div>
                    <%- include('partials_arena_score_details', { row, userId }) %>
                    <strong class="arena-player-fp"><%= row?.fp || 0 %> FP</strong>
                  </div>
                  <% if (!isLeft && row?.card) { %><div class="arena-duel-card arena-wut-card tier-<%= row.card.player.tier %>"><%- include('partials_wut_card', { card: displayCardFor(focusedMatch, row), statusText: `${row.fp || 0} FP in Match #${focusedMatch.id}` }) %></div><% } %>
                </article>
              <% }) %>
            </div>
          <% }) %>
        </div>

        <div class="arena-outcome" data-arena-outcome>
          <% if (focusedMatch.winner_user_id == null) { %><h2>Draw</h2>
          <% } else if (Number(focusedMatch.winner_user_id) === Number(currentUser.id)) { %>
            <h2>You Won!</h2>
            <% if (draftContext) { %><span class="pill positive">Tournament win</span><% } else if (Number(focusedMatch.rules_version || 1) >= 2) { %><span class="pill"><%= focusedMatch.wut_rewards?.[String(currentUser.id)] || 0 %> WUT Coins awarded</span><% } else if (!focusedMatch.winnings_claimed_at) { %><form method="post" action="/cards/arena/matches/<%= focusedMatch.id %>/claim"><button>Collect legacy winnings</button></form><% } else { %><span class="pill">Winnings collected</span><% } %>
          <% } else { %><h2>You lost. Better luck next time.</h2><% } %>
        </div>
      </section>
    <% } %>

    <section class="card arena-history">
      <div class="cards-section-head"><div><p class="eyebrow">All completed matches</p><h2>Results</h2></div></div>
      <% if (!arena.history.length) { %><p class="muted">Completed matches will appear here.</p><% } %>
      <% arena.history.forEach(match => { %>
        <% const ownRating = match.players.find(player => Number(player.id) === Number(currentUser.id)); %>
        <div class="arena-history-row"><span><strong>#<%= match.id %> vs <%= match.opponent.displayName %></strong><small><%= match.scores[String(currentUser.id)] %>–<%= match.scores[String(match.opponent.id)] %> · <%= Number(match.winner_user_id) === Number(currentUser.id) ? 'Win' : match.winner_user_id == null ? 'Draw' : 'Loss' %><%= match.forfeit_user_id ? ' · timeout forfeit' : '' %><%= ownRating?.eloChange == null ? '' : ` · ELO ${ownRating.eloBefore} → ${ownRating.elo} (${ownRating.eloChange >= 0 ? '+' : ''}${ownRating.eloChange})` %></small></span><a class="button-link ghost" href="<%= draftContext ? `/cards/drafts/${draftContext.id}/matches/${match.id}/results#arena-results` : `/cards/arena/history?replay=${match.id}#arena-results` %>">Replay Reveal</a></div>
      <% }) %>
    </section>
  </main>
  <%- include('partials_arena_reveal_script') %>
</body>
</html>
