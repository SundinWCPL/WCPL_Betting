<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WCPL Card Shop</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/card-name-fit.js" defer></script>
</head>
<body>
  <%- include('partials_header') %>
  <%
    const cardRarityRank = { common: 1, uncommon: 2, rare: 3, epic: 4, legendary: 5, mythic: 6 };
    const starsForPlayer = player => '&#9733;'.repeat(Number(player?.stars || cardRarityRank[player?.tier] || 1));
    const titleCase = wutTitleCase;
    const trinketName = wutTrinketName;
    const trinketIcons = WUT_TRINKET_ICONS;
    const trinketEffectText = wutTrinketDescription;
    const trinketTooltip = item => `${trinketName(item.family)} · ${titleCase(item.rarity)} · +${item.power_cost} Power\n${trinketEffectText(item)}`;
    const boostPack = {
      price: 250,
      commonRareRolls: 4,
      guaranteedHighRolls: 1,
      commonRareOdds: { common: 55, uncommon: 30, rare: 15 },
      guaranteedHighOdds: { epic: 85, legendary: 15 },
      ...(config.boostPack || {})
    };
    const boostPackCount = Number(boostPack.commonRareRolls || 0) + Number(boostPack.guaranteedHighRolls || 0);
    const pendingPackLabel = pendingPack
      ? pendingPack.source === 'starter_bonus'
        ? 'Free Starter Bonus Pack'
        : pendingPack.pack_kind === 'boost'
          ? 'Boost Pack'
          : `${pendingPack.pack_type} ${pendingPack.pack_kind} pack`
      : '';
    const cleanPlayerName = player => {
      const edition = String(player?.edition || '').trim();
      const name = String(player?.name || '').trim();
      return edition && name.toUpperCase().startsWith(`${edition.toUpperCase()} `)
        ? name.slice(edition.length).trim()
        : name;
    };
  %>
  <main class="container cards-page">
    <section class="card page-title cards-title">
      <div><p class="eyebrow">WUT Economy</p><h1>WUT Shop</h1><p>Buy player packs, boost packs, and trinkets.</p></div>
      <div class="cards-title-actions"><span class="cards-balance"><%= Math.ceil(wutCoins) %> WUT Coins</span><a class="button-link ghost" href="/cards">Back to Hub</a></div>
    </section>
    <% if (wut.config.freeShopPurchases) { %><section class="card casino-closed-notice"><strong>Admin testing: shop purchases are free.</strong><span>Pack, trinket, and shop-reroll prices are not charged while this toggle is active.</span></section><% } %>

    <% if (pendingPack) { %>
      <section class="card pack-reveal">
        <p class="eyebrow"><%= pendingPackLabel %></p>
        <h2>Your Pack</h2>
        <div class="pack-reveal-grid">
          <% pendingPack.items.forEach((item, index) => { %>
            <button type="button" class="pack-card is-hidden tier-<%= item.itemType === 'player' ? item.player?.tier : item.rarity %>" data-reveal-card aria-label="Reveal card <%= index + 1 %>">
              <span class="pack-card-cover" aria-hidden="true">
                <strong>?</strong>
              </span>
              <span class="pack-card-content <%= item.itemType === 'player' ? 'wut-card-face wut-card-front' : '' %>" data-card-edition="<%= item.itemType === 'player' ? String(item.player?.cardArt || item.player?.card_art || item.cardArt || item.player?.edition || '').trim().toUpperCase() : '' %>">
                <% if (item.itemType === 'player') { %>
                  <span class="wut-front-badge <%= item.player?.cardType === 'mythic' ? 'is-position-only' : '' %>">
                    <% if (item.player?.cardType !== 'mythic') { %><span><%= item.player?.edition %></span><% } %>
                    <strong><%= item.player?.position %></strong>
                  </span>
                  <span class="wut-front-copy">
                    <strong class="player-card-name"><%= item.player ? cleanPlayerName(item.player) : item.playerKey %></strong>
                    <span class="wut-front-stat pack-player-details">
                      <strong><%= titleCase(item.player?.tier) %> <%- starsForPlayer(item.player) %></strong>
                    </span>
                  </span>
                  <% if (item.player?.teamLogo) { %><img class="wut-front-logo" src="<%= item.player.teamLogo %>" alt="" style="--team-bg:<%= item.player.teamBgColor %>"><% } %>
                <% } else { %>
                  <%- include('partials_boost_content', { boost: item }) %>
                <% } %>
              </span>
            </button>
          <% }) %>
        </div>
        <form method="post" action="/cards/store/claim">
          <input type="hidden" name="purchase_id" value="<%= pendingPack.id %>">
          <button id="claimPack" disabled>Add to Collection</button>
        </form>
      </section>
    <% } else { %>
      <section class="wut-shop-columns">
        <article class="card pack-shop-column">
          <% const prices = config.playerPackPrices; %>
          <div class="pack-art player-pack"><span>PLAYER</span><strong>PACK</strong></div>
          <h2>Player + Boost Packs</h2>
          <% ['standard', 'premium', 'prestige'].forEach(type => { %>
            <form method="post" action="/cards/store/buy"><input type="hidden" name="pack_kind" value="player"><input type="hidden" name="pack_type" value="<%= type %>"><button class="pack-buy-button" <%= !wut.config.freeShopPurchases && wutCoins < prices[type] ? 'disabled' : '' %>><span><%= type %></span><strong><%= wut.config.freeShopPurchases ? 'FREE · Admin Test' : `${prices[type]} WUT Coins` %></strong></button></form>
          <% }) %>
        </article>
        <article class="card pack-shop-column">
          <div class="pack-art boost-pack"><span>BOOST</span><strong>PACK</strong></div>
          <h2>Boost Pack</h2>
          <p class="muted"><%= boostPackCount %> boosts: <%= Number(boostPack.commonRareRolls || 0) %> common-rare roll(s) plus <%= Number(boostPack.guaranteedHighRolls || 0) %> epic-legendary guarantee(s).</p>
          <form method="post" action="/cards/store/buy">
            <input type="hidden" name="pack_kind" value="boost">
            <input type="hidden" name="pack_type" value="boost">
            <button class="pack-buy-button" <%= !wut.config.freeShopPurchases && wutCoins < boostPack.price ? 'disabled' : '' %>><span>boost</span><strong><%= wut.config.freeShopPurchases ? 'FREE - Admin Test' : `${boostPack.price} WUT Coins` %></strong></button>
          </form>
        </article>
        <article class="card wut-trinket-shop-panel">
          <div class="cards-section-head"><div><p class="eyebrow">Your personal daily rotation</p><h2>Trinket Shop</h2><p class="muted wut-shop-refresh">New offers at midnight <%= wut.shop.refresh_timezone === 'America/Los_Angeles' ? 'Pacific' : `(${wut.shop.refresh_timezone})` %> · <span data-shop-refresh-at="<%= wut.shop.next_refresh_at %>">--:--:--</span></p></div><span class="pill"><%= wut.shop.date_key %></span></div>
          <div class="wut-shop-trinket-stack <%= wut.shop.locked_slot ? 'has-locked-offer' : '' %>" data-locked-slot="<%= wut.shop.locked_slot || '' %>">
            <% wut.shop.offers.forEach(offer => { %><article class="wut-shop-trinket-offer tier-<%= offer.rarity %> <%= offer.sold_at ? 'is-sold' : '' %>" data-trinket-family="<%= offer.family %>"><span class="wut-trinket-icon wut-shop-trinket-icon" title="<%= trinketTooltip(offer) %>"><%= trinketIcons[offer.family] || '◆' %></span><strong class="wut-shop-trinket-name"><%= titleCase(offer.rarity) %> <%= trinketName(offer.family) %></strong><form method="post" action="/cards/trinkets/buy"><input type="hidden" name="slot" value="<%= offer.slot %>"><button <%= offer.sold_at || (!wut.config.freeShopPurchases && wutCoins < offer.price) ? 'disabled' : '' %>><%= offer.sold_at ? 'Sold Out' : wut.config.freeShopPurchases ? 'FREE' : `${offer.price} WUT Coins` %></button></form></article><% }) %>
          </div>
          <button type="button" id="openTrinketReroll">Reroll Trinket Shop</button>
        </article>
      </section>
      <dialog id="rerollTrinketDialog" class="wut-trinket-dialog"><h2>Reroll trinket shop?</h2><p>This refreshes all three offers, including sold-out slots.</p><div class="admin-action-row"><% if (wut.config.freeShopPurchases) { %><form method="post" action="/cards/trinkets/reroll"><input type="hidden" name="currency" value="wut"><button>Reroll Free</button></form><% } else { %><form method="post" action="/cards/trinkets/reroll"><input type="hidden" name="currency" value="wut"><button><%= wut.config.shopReroll.wut %> WUT Coins</button></form><form method="post" action="/cards/trinkets/reroll"><input type="hidden" name="currency" value="mushy"><button><%= wut.config.shopReroll.mushy %> Mushybux</button></form><% } %><button type="button" class="ghost" id="cancelTrinketReroll">Cancel</button></div></dialog>
    <% } %>
  </main>
  <script>
    const rerollDialog = document.getElementById('rerollTrinketDialog');
    document.getElementById('openTrinketReroll')?.addEventListener('click', () => rerollDialog.showModal());
    document.getElementById('cancelTrinketReroll')?.addEventListener('click', () => rerollDialog.close());
    const trinketStack = document.querySelector('.wut-shop-trinket-stack');
    if (trinketStack) {
      const lockedSlot = trinketStack.dataset.lockedSlot || '';
      if (lockedSlot) {
        const rerollCopy = rerollDialog?.querySelector('p');
        if (rerollCopy) rerollCopy.textContent = 'Your locked offer will stay, and the other slots will refresh.';
      }
      trinketStack.querySelectorAll('.wut-shop-trinket-offer').forEach(offer => {
        const slot = offer.querySelector('input[name="slot"]')?.value || '';
        const locked = lockedSlot && slot === lockedSlot;
        if (lockedSlot && !locked) offer.hidden = true;
        offer.classList.toggle('is-locked', Boolean(locked));
        const form = document.createElement('form');
        form.method = 'post';
        form.action = '/cards/trinkets/lock';
        form.className = 'wut-shop-lock-form';
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = 'slot';
        input.value = slot;
        const button = document.createElement('button');
        button.type = 'submit';
        button.className = 'wut-shop-lock-button';
        button.disabled = offer.classList.contains('is-sold');
        button.title = locked ? 'Unlock this offer' : 'Lock this offer through rerolls';
        button.setAttribute('aria-label', locked ? 'Unlock this trinket offer' : 'Lock this trinket offer');
        button.textContent = locked ? String.fromCodePoint(0x1f512) : String.fromCodePoint(0x1f513);
        form.append(input, button);
        offer.prepend(form);
      });
    }
    const revealCards = [...document.querySelectorAll('[data-reveal-card]')];
    revealCards.forEach(card => card.addEventListener('click', () => {
      card.classList.remove('is-hidden');
      card.classList.remove('is-revealed-pop');
      void card.offsetWidth;
      card.classList.add('is-revealed-pop');
      card.disabled = true;
      window.fitWutCardNames?.();
      card.addEventListener('animationend', () => card.classList.remove('is-revealed-pop'), { once: true });
      if (revealCards.every(item => !item.classList.contains('is-hidden'))) document.getElementById('claimPack').disabled = false;
    }));
    const refreshClock = document.querySelector('[data-shop-refresh-at]');
    if (refreshClock) {
      const renderRefreshClock = () => {
        const remaining = Math.max(0, new Date(refreshClock.dataset.shopRefreshAt).getTime() - Date.now());
        const hours = Math.floor(remaining / 3600000);
        const minutes = Math.floor(remaining % 3600000 / 60000);
        const seconds = Math.floor(remaining % 60000 / 1000);
        refreshClock.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`;
        if (remaining === 0) window.location.reload();
      };
      renderRefreshClock();
      setInterval(renderRefreshClock, 1000);
    }
  </script>
</body>
</html>
