<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Admin · WCPL Betting</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials_header') %>

  <main class="container">
    <section class="card page-title compact-title">
      <div>
        <p class="eyebrow">Commissioner Controls</p>
        <h1>Admin Panel</h1>
        <p>
          Season: <strong><%= settings.seasonId %></strong> ·
          Current Week: <strong><%= currentWeek %></strong> ·
          Next Week Review: <strong><%= nextWeek %></strong> ·
          Preparing Week: <strong><%= nextWeek %></strong>
        </p>
        <p class="muted">
          Week <%= currentWeek %> status:
          <strong class="<%= settings.currentWeekLocked ? 'negative' : 'positive' %>">
            <%= settings.currentWeekLocked ? 'Locked' : 'Open' %>
          </strong>
          · Week <%= nextWeek %> lines:
          <strong>
            Not published
          </strong>
        </p>
      </div>
    </section>

    <section class="admin-grid">
      <article class="card admin-card">
        <h2>League Controls</h2>

        <form method="post" action="/admin/season" class="admin-inline-form" onsubmit="return confirm('Switch season and reset the debug week to Week 1?');">
          <label>
            Debug season
            <select name="season_id">
              <% seasons.forEach(season => { %>
                <option value="<%= season %>" <%= season === settings.seasonId ? 'selected' : '' %>><%= season %></option>
              <% }) %>
            </select>
          </label>
          <button type="submit">Switch Season</button>
        </form>

        <div class="admin-action-row">
          <% if (settings.currentWeekLocked) { %>
            <form method="post" action="/admin/unlock">
              <button>Unlock Week <%= currentWeek %></button>
            </form>
          <% } else { %>
            <form method="post" action="/admin/lock">
              <button>Lock Week <%= currentWeek %></button>
            </form>
          <% } %>
        </div>

        <p class="muted small-note">
          Betting is available only for the current week. Lock it shortly before the first series begins.
        </p>

        <form method="post" action="/admin/allowance" class="admin-inline-form">
          <label>
            Weekly allowance
            <input type="number" name="weekly_allowance" min="0" step="1" value="<%= settings.weeklyAllowance %>">
          </label>
          <button type="submit">Save Allowance</button>
        </form>

        <form method="post" action="/admin/advance-week" class="admin-danger-zone" onsubmit="return confirm('Advance to Week <%= currentWeek + 1 %>? This will be blocked if any Week <%= currentWeek %> bets are still unsettled.');">
          <div>
            <strong>Advance Week</strong>
            <p class="muted">Publishes the reviewed Week <%= currentWeek + 1 %> lines, opens betting, applies allowance, and refunds any open bets from the retired hat-trick market. Existing series bets inherit the published line and payout.</p>
          </div>
          <button type="submit">Advance Week</button>
        </form>
      </article>

      <article class="card admin-card">
        <h2>Testing / Emergency Resets</h2>

        <form method="post" action="/admin/reset-week-bets" class="admin-danger-zone" onsubmit="return confirm('Void all Week <%= currentWeek %> bets and refund stakes?');">
          <input type="hidden" name="week" value="<%= currentWeek %>">
          <div>
            <strong>Reset Current Week Bets</strong>
            <p class="muted">Voids all open bets for Week <%= currentWeek %> and refunds stakes.</p>
          </div>
          <button type="submit">Void Week <%= currentWeek %> Bets</button>
        </form>

        <form method="post" action="/admin/reset-all-data" class="admin-danger-zone hard-reset" onsubmit="return confirm('Reset ALL test data? This clears bets, transactions, balances, and restores seeded users.');">
          <div>
            <strong>Reset All Test Data</strong>
            <p class="muted">Clears the JSON database back to seeded users and starting Mushybux.</p>
          </div>
          <button type="submit">Reset All Data</button>
        </form>
      </article>
    </section>

    <section class="card admin-card" id="casino-controls">
      <div class="admin-section-head">
        <div>
          <p class="eyebrow">Casino Operations</p>
          <h2>Casino Controls</h2>
        </div>
        <span class="pill <%= settings.casinoOpen ? 'positive' : 'negative' %>">
          <%= settings.casinoOpen ? 'Open' : 'Closed' %>
        </span>
      </div>

      <div class="casino-admin-metrics">
        <div>
          <span class="muted">Amount Wagered</span>
          <strong><%= Number(casinoSummary.totalWagered || 0).toLocaleString() %></strong>
        </div>
        <div>
          <span class="muted">Amount Won</span>
          <strong><%= Number(casinoSummary.totalPaid || 0).toLocaleString() %></strong>
        </div>
        <div>
          <span class="muted">Net Profit</span>
          <strong class="<%= Number(casinoSummary.netProfit || 0) >= 0 ? 'positive' : 'negative' %>">
            <%= Number(casinoSummary.netProfit || 0).toLocaleString() %>
          </strong>
        </div>
      </div>

      <div class="admin-action-row">
        <% if (settings.casinoOpen) { %>
          <form method="post" action="/admin/casino/close">
            <button type="submit">Close Casino</button>
          </form>
        <% } else { %>
          <form method="post" action="/admin/casino/open">
            <button type="submit">Open Casino</button>
          </form>
        <% } %>

        <% if (settings.casinoLinkVisible) { %>
          <form method="post" action="/admin/casino/hide-link">
            <button type="submit">Hide Casino Link</button>
          </form>
        <% } else { %>
          <form method="post" action="/admin/casino/show-link">
            <button type="submit">Show Casino Link</button>
          </form>
        <% } %>
      </div>

      <form method="post" action="/admin/casino/horse-racing-config" class="horse-admin-config-form">
        <label>Maximum race bet
          <input type="number" name="max_bet" min="1" step="1" value="<%= casinoSummary.horseRacingConfig.maxBet %>" required>
        </label>
        <label>Horse purchase cost
          <input type="number" name="horse_purchase_price" min="1" step="1" value="<%= casinoSummary.horseRacingConfig.horsePurchasePrice %>" required>
        </label>
        <label>Owner bet cut
          <span class="admin-number-suffix"><input type="number" name="owner_bet_share_percent" min="0" max="100" step="0.1" value="<%= casinoSummary.horseRacingConfig.ownerBetSharePercent %>" required><b>%</b></span>
        </label>
        <label>Owner win bonus
          <input type="number" name="owner_win_bonus" min="0" step="1" value="<%= casinoSummary.horseRacingConfig.ownerWinBonus %>" required>
        </label>
        <button type="submit">Save Horse Racing</button>
      </form>

      <p class="muted small-note">
        Navigation link: <strong><%= settings.casinoLinkVisible ? 'Visible' : 'Hidden' %></strong>.
        Closing the casino disables slots and Puck IQ even when someone enters the URL manually.
      </p>

      <form method="post" action="/admin/casino/reset" class="admin-danger-zone hard-reset" onsubmit="return confirm('Reset ALL casino data? This removes every slot spin and Puck IQ run, deletes casino ledger entries, and restores user balances as though the casino activity never happened.');">
        <div>
          <strong>Reset Casino Data</strong>
          <p class="muted">Wipes all casino history and reverses every user’s casino winnings or losses.</p>
        </div>
        <button type="submit">Reset Casino Data</button>
      </form>
    </section>

    <section class="card admin-card" id="cards-controls">
      <div class="admin-section-head">
        <div>
          <p class="eyebrow">WUT Collection Game</p>
          <h2>WCPL Cards Controls</h2>
        </div>
        <div class="admin-action-row">
          <span class="pill <%= settings.cardsOpen ? 'positive' : 'negative' %>"><%= settings.cardsOpen ? 'Open' : 'Closed' %></span>
          <span class="pill"><%= settings.cardsLinkVisible ? 'Link Visible' : 'Link Hidden' %></span>
          <span class="pill <%= cardsAdmin.config.wut.freeShopPurchases ? 'positive' : '' %>"><%= cardsAdmin.config.wut.freeShopPurchases ? 'Free Shop Testing' : 'Normal Shop Prices' %></span>
          <a class="button-link ghost" href="/admin/cards/matches">Match Admin</a>
          <button type="button" class="button-link ghost admin-collapse-toggle" data-target="adminCardsControlsBody">Show</button>
        </div>
      </div>
      <div id="adminCardsControlsBody" class="admin-collapsible-body" hidden>

      <div class="casino-admin-metrics">
        <div><span class="muted">Owned Cards</span><strong><%= cardsAdmin.totals.ownedCards %></strong></div>
        <div><span class="muted">Owned Boosts</span><strong><%= cardsAdmin.totals.ownedBoosts %></strong></div>
        <div><span class="muted">Owned Trinkets</span><strong><%= cardsAdmin.totals.ownedTrinkets %></strong></div>
        <div><span class="muted">Saved Decks</span><strong><%= cardsAdmin.totals.savedDecks %></strong></div>
        <div><span class="muted">WUT Members</span><strong><%= cardsAdmin.totals.wutMembers %></strong></div>
        <div><span class="muted">Packs Purchased</span><strong><%= cardsAdmin.totals.packs %></strong></div>
        <div><span class="muted">WUT Queue</span><strong><%= cardsAdmin.totals.queuedArenaEntries %></strong></div>
        <div><span class="muted">Active Matches</span><strong><%= cardsAdmin.totals.activeArenaMatches %></strong></div>
      </div>

      <div class="admin-action-row">
        <% if (settings.cardsOpen) { %>
          <form method="post" action="/admin/cards/close"><button>Close WUT</button></form>
        <% } else { %>
          <form method="post" action="/admin/cards/open"><button>Open WUT</button></form>
        <% } %>
        <% if (settings.cardsLinkVisible) { %>
          <form method="post" action="/admin/cards/hide-link"><button>Hide Cards Link</button></form>
        <% } else { %>
          <form method="post" action="/admin/cards/show-link"><button>Show Cards Link</button></form>
        <% } %>
        <form method="post" action="/admin/cards/recalculate"><button>Recalculate Player Tiers</button></form>
        <form method="post" action="/admin/cards/free-shop"><input type="hidden" name="enabled" value="<%= cardsAdmin.config.wut.freeShopPurchases ? 'false' : 'true' %>"><button><%= cardsAdmin.config.wut.freeShopPurchases ? 'Disable Free Shop' : 'Enable Free Shop Testing' %></button></form>
      </div>
      <p class="muted small-note">Closing WUT pauses all pages, purchases, matches, queue entries, and matchmaking. Link visibility is controlled separately.</p>

      <section class="admin-wut-coin-adjuster">
        <div><strong>Adjust User WUT Coins</strong><p class="muted small-note">Use a positive amount to grant coins or a negative amount to remove them. Every change is recorded in the WUT ledger.</p></div>
        <% if (cardsAdmin.wutUsers.length) { %>
          <form method="post" action="/admin/cards/wut-coins" class="admin-action-row" onsubmit="return confirm(`Adjust this user's WUT Coin balance by ${this.amount.value}?`);">
            <select name="user_id" required><% cardsAdmin.wutUsers.forEach(user => { %><option value="<%= user.userId %>"><%= user.displayName %> · <%= user.wutCoins %> WUT Coins<%= user.starterOpened ? '' : ' · Starter unopened' %></option><% }) %></select>
            <input type="number" name="amount" step="1" placeholder="+/- WUT Coins" required>
            <input type="text" name="note" maxlength="160" placeholder="Reason (required)" required>
            <button type="submit">Adjust WUT Balance</button>
          </form>
        <% } else { %><p class="muted">No users have joined WUT yet.</p><% } %>
        <% if (cardsAdmin.recentWutAdjustments.length) { %>
          <details><summary>Recent WUT Coin adjustments</summary><div class="table-scroll"><table><thead><tr><th>User</th><th>Change</th><th>Balance After</th><th>Reason</th><th>Time</th></tr></thead><tbody><% cardsAdmin.recentWutAdjustments.forEach(row => { %><tr><td><%= row.displayName %></td><td><strong><%= row.amount > 0 ? '+' : '' %><%= row.amount %></strong></td><td><%= row.balance_after %></td><td><%= row.note %></td><td><%= new Date(row.created_at).toLocaleString() %></td></tr><% }) %></tbody></table></div></details>
        <% } %>
      </section>

      <form method="post" action="/admin/cards/config" class="cards-admin-config">
        <% const wutRarities = ['common','uncommon','rare','epic','legendary']; %>
        <fieldset>
          <legend>Player + Boost Pack Prices</legend>
          <p class="muted">Each pack contains three players and two boosts.</p>
          <% ['standard','premium','prestige'].forEach(packType => { %>
            <label><%= packType %> <input type="number" min="0" step="1" name="playerPackPrices[<%= packType %>]" value="<%= cardsAdmin.config.playerPackPrices[packType] %>"></label>
          <% }) %>
        </fieldset>
        <fieldset class="cards-rarity-fieldset">
          <legend>Trinket Purchase & Removal Costs</legend>
          <p class="muted">Purchase and WUT removal costs use WUT Coins. Mushybux removal is the convenience alternative.</p>
          <div class="cards-admin-trinket-economy">
            <strong>Rarity</strong><strong>Purchase</strong><strong>Remove: WUT</strong><strong>Remove: Mushybux</strong>
            <% wutRarities.forEach(rarity => { %>
              <b class="tier-text-<%= rarity %>"><%= rarity %></b>
              <input aria-label="<%= `${rarity} trinket price` %>" type="number" min="0" step="1" name="wut[trinketPrices][<%= rarity %>]" value="<%= cardsAdmin.config.wut.trinketPrices[rarity] %>">
              <input aria-label="<%= `${rarity} trinket WUT removal cost` %>" type="number" min="0" step="1" name="wut[trinketRemovalWut][<%= rarity %>]" value="<%= cardsAdmin.config.wut.trinketRemovalWut[rarity] %>">
              <input aria-label="<%= `${rarity} trinket Mushybux removal cost` %>" type="number" min="0" step="1" name="wut[trinketRemovalMushy][<%= rarity %>]" value="<%= cardsAdmin.config.wut.trinketRemovalMushy[rarity] %>">
            <% }) %>
          </div>
        </fieldset>
        <fieldset>
          <legend>Trinket Shop Reroll Costs</legend>
          <label>WUT Coins <input type="number" min="0" step="1" name="wut[shopReroll][wut]" value="<%= cardsAdmin.config.wut.shopReroll.wut %>"></label>
          <label>Mushybux <input type="number" min="0" step="1" name="wut[shopReroll][mushy]" value="<%= cardsAdmin.config.wut.shopReroll.mushy %>"></label>
        </fieldset>
        <fieldset class="cards-rarity-fieldset">
          <legend>Trinket Shop Rarity Weights</legend>
          <p class="muted">Relative daily-shop weights. Each slot needs at least one positive value.</p>
          <div class="cards-odds-table cards-odds-table-five">
            <span></span><% wutRarities.forEach(rarity => { %><strong class="tier-text-<%= rarity %>"><%= rarity %></strong><% }) %>
            <% ['1','2','3'].forEach(slot => { %><b>Slot <%= slot %></b><% wutRarities.forEach(rarity => { %><input aria-label="<%= `Trinket slot ${slot} ${rarity}` %>" type="number" min="0" step="0.01" name="wut[trinketShopOdds][slot<%= slot %>][<%= rarity %>]" value="<%= cardsAdmin.config.wut.trinketShopOdds[slot][rarity] %>"><% }) %><% }) %>
          </div>
        </fieldset>
        <fieldset class="cards-rarity-fieldset">
          <legend>Match Rules & Rewards</legend>
          <div class="cards-scoring-config-grid">
            <label>Matching-slot Power allowance<input type="number" min="0" step="1" name="wut[slotPowerAllowance]" value="<%= cardsAdmin.config.wut.slotPowerAllowance %>"></label>
            <label>Base lineup Boost Load<input type="number" min="0" step="1" name="wut[boostLoadCap]" value="<%= cardsAdmin.config.wut.boostLoadCap %>"></label>
            <label>Winner WUT Coins<input type="number" min="0" step="1" name="wut[rewards][winner]" value="<%= cardsAdmin.config.wut.rewards.winner %>"></label>
            <label>Loser WUT Coins<input type="number" min="0" step="1" name="wut[rewards][loser]" value="<%= cardsAdmin.config.wut.rewards.loser %>"></label>
            <label>Timeout loser WUT Coins<input type="number" min="0" step="1" name="wut[rewards][forfeitLoser]" value="<%= cardsAdmin.config.wut.rewards.forfeitLoser %>"></label>
            <label>Active hours per turn<input type="number" min="0.25" step="0.25" name="arena[turnHours]" value="<%= cardsAdmin.arenaConfig.turnHours %>"></label>
            <label>Paused clock starts (0–23)<input type="number" min="0" max="23" step="1" name="arena[pauseStartHour]" value="<%= cardsAdmin.arenaConfig.pauseStartHour %>"></label>
            <label>Paused clock ends (0–23)<input type="number" min="0" max="23" step="1" name="arena[pauseEndHour]" value="<%= cardsAdmin.arenaConfig.pauseEndHour %>"></label>
            <label>Maximum active matches/user<input type="number" min="1" step="1" name="arena[maxActiveMatches]" value="<%= cardsAdmin.arenaConfig.maxActiveMatches %>"></label>
          </div>
        </fieldset>
        <fieldset class="cards-rarity-fieldset">
          <legend>Extra Saved Deck Slot Costs</legend>
          <div class="cards-scoring-config-grid"><% ['4','5','6','7','8'].forEach(slot => { %><label>Slot <%= slot %> Mushybux<input type="number" min="0" step="1" name="wut[deckSlotCosts][slot<%= slot %>]" value="<%= cardsAdmin.config.wut.deckSlotCosts[slot] %>"></label><% }) %></div>
        </fieldset>
        <fieldset class="cards-rarity-fieldset">
          <legend>Mission WUT Coin Rewards</legend>
          <div class="cards-scoring-config-grid">
            <% [['daily_play_three','Daily: play three'],['daily_first_win','Daily: first win'],['daily_rotating','Daily: rotating'],['weekly_profit_500','Weekly: 500 profit'],['weekly_category_coverage','Weekly: cover board'],['weekly_rotating','Weekly: rotating']].forEach(([key,label]) => { %><label><%= label %><input type="number" min="0" step="1" name="wut[missionRewards][<%= key %>]" value="<%= cardsAdmin.config.wut.missionRewards[key] %>"></label><% }) %>
          </div>
        </fieldset>
        <% [
          ['playerTierOdds', 'Player Rarity Weights'],
          ['boostRarityOdds', 'Boost Rarity Weights']
        ].forEach(([group, title]) => { %>
          <fieldset class="cards-rarity-fieldset">
            <legend><%= title %></legend>
            <p class="muted">Relative weights; decimals are allowed and the row does not need to total 100.</p>
            <div class="cards-odds-table">
              <span></span>
              <% ['common','uncommon','rare','epic','legendary','mythic'].forEach(rarity => { %><strong class="tier-text-<%= rarity %>"><%= rarity %></strong><% }) %>
              <% ['standard','premium','prestige'].forEach(packType => { %>
                <b><%= packType %></b>
                <% ['common','uncommon','rare','epic','legendary','mythic'].forEach(rarity => { %>
                  <input aria-label="<%= `${title} ${packType} ${rarity}` %>" type="number" min="0" step="0.01"
                    name="<%= group %>[<%= packType %>][<%= rarity %>]"
                    value="<%= cardsAdmin.config[group][packType][rarity] %>">
                <% }) %>
              <% }) %>
            </div>
          </fieldset>
        <% }) %>
        <fieldset class="cards-rarity-fieldset">
          <legend>Fantasy Stat Values</legend>
          <p class="muted">Base FP awarded for each recorded stat.</p>
          <div class="cards-scoring-config-grid">
            <% [['goal','Goal'],['assist','Assist'],['shot','Shot'],['hit','Hit'],['block','Block'],['save','Save'],['shutout','Shutout']].forEach(([type,label]) => { %>
              <label><%= label %> FP
                <input type="number" min="0" step="0.1" name="scoring[statPoints][<%= type %>]" value="<%= cardsAdmin.config.scoring.statPoints[type] %>" required>
              </label>
            <% }) %>
          </div>
        </fieldset>
        <fieldset class="cards-rarity-fieldset">
          <legend>Save% Bonuses</legend>
          <p class="muted">The highest minimum Save% reached determines the multiplier applied to Save FP.</p>
          <div class="cards-save-pct-config">
            <strong>Minimum Save%</strong><strong>Save FP multiplier</strong>
            <% cardsAdmin.config.scoring.savePctBonuses.forEach((row, index) => { %>
              <input aria-label="Save percentage threshold <%= index + 1 %>" type="number" min="0" max="1" step="0.001" name="scoring[savePctBonuses][<%= index %>][threshold]" value="<%= row.threshold %>" required>
              <input aria-label="Save percentage multiplier <%= index + 1 %>" type="number" min="0" step="0.01" name="scoring[savePctBonuses][<%= index %>][multiplier]" value="<%= row.multiplier %>" required>
            <% }) %>
          </div>
        </fieldset>
        <fieldset class="cards-rarity-fieldset">
          <legend>Team Chemistry</legend>
          <p class="muted">Percentage added to each matching teammate's total FP after all stat and boost scoring.</p>
          <div class="cards-scoring-config-grid">
            <% ['2','3','4','5'].forEach(count => { %>
              <label><%= count %> same-team players
                <span class="admin-number-suffix"><input type="number" min="0" step="1" name="scoring[chemistryBonuses][players<%= count %>]" value="<%= cardsAdmin.config.scoring.chemistryBonuses[count] %>" required><b>%</b></span>
              </label>
            <% }) %>
          </div>
        </fieldset>
        <fieldset class="cards-rarity-fieldset">
          <legend>Flat Boost Values</legend>
          <p class="muted">Bonus is awarded once per interval: floor(stat / per) × bonus. Grit applies that calculation separately to both Hits and Blocks.</p>
          <div class="cards-boost-config-grid">
            <% boostTypes.forEach(type => { %>
              <% ['common','uncommon','rare','epic','legendary'].forEach(rarity => { const effect = boostEffects[type][rarity]; %>
                <label><span class="tier-text-<%= rarity %>"><%= type %> · <%= rarity %></span>
                  <span class="admin-action-row">
                    <input aria-label="<%= `${type} ${rarity} per` %>" type="number" min="1" step="1" name="boostEffects[<%= type %>][<%= rarity %>][per]" value="<%= effect.per %>">
                    <input aria-label="<%= `${type} ${rarity} bonus` %>" type="number" min="0" step="1" name="boostEffects[<%= type %>][<%= rarity %>][bonus]" value="<%= effect.bonus %>">
                  </span>
                </label>
              <% }) %>
            <% }) %>
          </div>
        </fieldset>
        <fieldset class="cards-rarity-fieldset wut-trinket-effect-editor">
          <legend>Trinket Effect Balance</legend>
          <p class="muted">Choose a trinket and rarity. Percentages are entered as human percentages; mode-only effects remain read-only.</p>
          <% const trinketFamilies = Object.keys(trinketAdminFields); const trinketEffectValue = (effect, field) => { const raw = field.key === 'value' ? effect : effect?.[field.key]; return field.kind === 'percent' ? Number((Number(raw || 0) * 100).toFixed(3)) : raw; }; %>
          <div class="admin-action-row wut-trinket-effect-selectors">
            <label>Trinket<select id="adminTrinketEffectFamily"><% trinketFamilies.forEach(family => { %><option value="<%= family %>"><%= wutTrinketName(family) %></option><% }) %></select></label>
            <label>Rarity<select id="adminTrinketEffectRarity"><% wutRarities.forEach(rarity => { %><option value="<%= rarity %>"><%= wutTitleCase(rarity) %></option><% }) %></select></label>
          </div>
          <% trinketFamilies.forEach((family, familyIndex) => { wutRarities.forEach((rarity, rarityIndex) => { const effect = cardsAdmin.config.wut.trinketEffects[family][rarity]; const fields = trinketAdminFields[family] || []; %>
            <section class="wut-trinket-effect-panel" data-trinket-effect-panel data-family="<%= family %>" data-rarity="<%= rarity %>" <%= familyIndex === 0 && rarityIndex === 0 ? '' : 'hidden' %>>
              <div><strong class="tier-text-<%= rarity %>"><%= wutTitleCase(rarity) %> <%= wutTrinketName(family) %></strong><p class="muted"><%= wutTrinketDescription({ family, rarity, effect }) %></p></div>
              <% if (!fields.length) { %><p class="cards-warning">This rarity changes behavior rather than a numeric FP value. Its mode is intentionally read-only.</p><% } else { %>
                <div class="cards-scoring-config-grid">
                  <% fields.forEach(field => { const formKey = /^\d+$/.test(field.key) ? `value${field.key}` : field.key; %><label><%= field.label %><span class="admin-number-suffix"><input type="number" min="<%= field.min %>" step="<%= field.step %>" name="wut[trinketEffects][<%= family %>][<%= rarity %>][<%= formKey %>]" value="<%= trinketEffectValue(effect, field) %>" required><% if (field.kind === 'percent') { %><b>%</b><% } %></span></label><% }) %>
                </div>
              <% } %>
            </section>
          <% }) }) %>
        </fieldset>
        <button>Save WUT Economy, Rules & Balance</button>
      </form>

      <div class="grid two">
        <form method="post" action="/admin/cards/grant" class="stacked-form">
          <h3>Grant Test Player Card</h3>
          <input type="hidden" name="item_type" value="player">
          <label>User
            <select name="user_id"><% users.forEach(user => { %><option value="<%= user.id %>"><%= user.display_name %></option><% }) %></select>
          </label>
          <label>Player
            <select name="catalog_key"><% cardsCatalog.forEach(player => { %><option value="<%= player.catalogKey %>"><%= player.edition %> · <%= player.divisionId %> · <%= player.tier %> · <%= player.name %> · <%= player.position || 'Review' %></option><% }) %></select>
          </label>
          <p class="muted">New cards enter the collection ready to play. WUT 2.0 cards have no cooldowns or contracts.</p>
          <button>Grant Player Card</button>
        </form>
        <form method="post" action="/admin/cards/grant" class="stacked-form">
          <h3>Grant Test Boost</h3>
          <input type="hidden" name="item_type" value="boost">
          <label>User
            <select name="user_id"><% users.forEach(user => { %><option value="<%= user.id %>"><%= user.display_name %></option><% }) %></select>
          </label>
          <label>Boost
            <select name="boost_type"><% boostTypes.forEach(type => { %><option value="<%= type %>"><%= type %></option><% }) %></select>
          </label>
          <label>Rarity
            <select name="rarity"><% ['common','uncommon','rare','epic','legendary'].forEach(rarity => { %><option value="<%= rarity %>"><%= rarity %></option><% }) %></select>
          </label>
          <button>Grant Boost</button>
        </form>
        <form method="post" action="/admin/cards/grant" class="stacked-form">
          <h3>Grant Test Trinket</h3>
          <input type="hidden" name="item_type" value="trinket">
          <label>User<select name="user_id"><% users.forEach(user => { %><option value="<%= user.id %>"><%= user.display_name %></option><% }) %></select></label>
          <label>Trinket<select name="trinket_family"><% trinketFamilies.forEach(family => { %><option value="<%= family %>"><%= wutTrinketName(family) %></option><% }) %></select></label>
          <label>Rarity<select name="rarity"><% wutRarities.forEach(rarity => { %><option value="<%= rarity %>"><%= rarity %></option><% }) %></select></label>
          <button>Grant Trinket</button>
        </form>
      </div>

      <form method="post" action="/admin/cards/reset" class="admin-danger-zone hard-reset" onsubmit="return confirm('Reset all WCPL Cards purchases, collections, WUT memberships, entries, matches, history, and reverse purchases?');">
        <div><strong>Reset Cards Data</strong><p class="muted">Keeps economy settings and manual player overrides.</p></div>
        <button>Reset Cards Data</button>
      </form>
      </div>
    </section>

    <section class="card admin-card" id="cards-player-pools">
      <div class="admin-section-head">
        <div><p class="eyebrow">S1+S2 historical pools and isolated S3 pools, split by position and ranked by expected FP/M</p><h2>Cards Player Pools</h2></div>
        <div class="admin-action-row">
          <span class="pill"><%= cardsCatalog.length %> players</span>
          <button type="button" class="button-link ghost admin-collapse-toggle" data-target="adminCardsPlayerPoolsBody">Show</button>
        </div>
      </div>
      <div id="adminCardsPlayerPoolsBody" class="admin-collapsible-body" hidden>
      <form method="post" action="/admin/cards/player-overrides" class="admin-bulk-card-overrides">
      <div class="table-scroll">
        <table>
          <thead><tr><th>Player</th><th>Rarity</th><th>S3 Position Counts</th><th>S2 Tie-break</th><th>GP</th><th>Expected FP/M</th><th>Position Override</th><th>Tier Override</th></tr></thead>
          <tbody>
            <% cardsCatalog.forEach(player => { %>
              <tr>
                <td><strong><%= player.name %></strong><br><span class="muted"><%= player.edition %> · <%= player.divisionId %> · <%= player.teamId %></span></td>
                <td><strong class="tier-text-<%= player.tier %>"><%= player.tier %></strong><% if (player.rarityProvisional) { %><br><small class="muted">Provisional; excluded from cutoffs</small><% } %></td>
                <td>F <%= player.positionCountsS3.F %> · D <%= player.positionCountsS3.D %> · G <%= player.positionCountsS3.G %></td>
                <td>F <%= player.positionCountsS2.F %> · D <%= player.positionCountsS2.D %> · G <%= player.positionCountsS2.G %></td>
                <td><%= player.rarityGamesPlayed || 0 %></td>
                <td><%= player.expectedWutFpPerMatch.toFixed(1) %></td>
                <td>
                    <select name="positions[<%= player.catalogKey %>]">
                      <option value="">Auto (<%= player.position || 'Review' %>)</option>
                      <% ['F','D','G'].forEach(pos => { %><option value="<%= pos %>" <%= cardsAdmin.positionOverrides[player.catalogKey] === pos ? 'selected' : '' %>><%= pos %></option><% }) %>
                    </select>
                </td>
                <td>
                    <select name="tiers[<%= player.catalogKey %>]">
                      <option value="">Auto (<%= player.tier %>)</option>
                      <% Object.keys(cardStars).forEach(tier => { %><option value="<%= tier %>" <%= cardsAdmin.tierOverrides[player.catalogKey] === tier ? 'selected' : '' %>><%= tier %></option><% }) %>
                    </select>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      <div class="admin-bulk-save-bar"><button type="submit">Save All Player Pool Changes</button></div>
      </form>
      </div>
    </section>



    <section class="card admin-card" id="user-balances">
      <h2>Backups</h2>
      <p class="muted">
        Database file: <code><%= backupInfo.backupDir %></code>
      </p>
      <% if (backupInfo.latestBackup) { %>
        <p class="muted">
          Latest server backup:
          <strong><%= backupInfo.latestBackup.name %></strong>
          · <%= new Date(backupInfo.latestBackup.createdAt).toLocaleString() %>
        </p>
      <% } else { %>
        <p class="muted">No server backups created yet.</p>
      <% } %>
      <div class="admin-action-row">
        <form method="post" action="/admin/backup/create">
          <button type="submit">Create Server Backup</button>
        </form>
        <a class="button-link ghost" href="/admin/backup/download">Download Backup</a>
      </div>
      <p class="muted small-note">Use this after settling/advancing each week. Server backups are saved beside the JSON database, which should be on the Railway volume.</p>
    </section>

    <section class="card admin-card">
      <h2>Add User</h2>
      <form method="post" action="/admin/add-user" class="admin-user-form">
        <label>
          Display name
          <input type="text" name="display_name" placeholder="Logan" required>
        </label>
        <label>
          Username
          <input type="text" name="username" placeholder="username" required>
        </label>
        <label>
          Password
          <input type="text" name="password" placeholder="Temporary password" required>
        </label>
        <label>
          Role
          <select name="role">
            <option value="user">User</option>
            <option value="admin">Admin</option>
          </select>
        </label>
        <button type="submit">Add User</button>
      </form>
    </section>


    <section class="card admin-card" id="series-bet-review">
      <div class="admin-section-head">
        <div>
          <p class="eyebrow">Writeup Helper · Week <%= currentWeek %></p>
          <h2>Series Bet Review</h2>
        </div>
        <button type="button" class="button-link ghost admin-collapse-toggle" data-target="adminSeriesBetReviewBody">Show</button>
      </div>
      <div id="adminSeriesBetReviewBody" class="admin-collapsible-body" hidden>
        <p class="muted">
          Review series markets and props involving players from either team. Voided and refunded bets are excluded.
        </p>

        <% if (seriesBetReview.length) { %>
          <label class="series-review-selector">
            Series
            <select id="seriesBetReviewSelect">
              <% seriesBetReview.forEach((series, index) => { %>
                <option value="<%= series.series_key %>" <%= index === 0 ? 'selected' : '' %>>
                  <%= series.division_name %> · <%= series.matchup_label %>
                </option>
              <% }) %>
            </select>
          </label>

          <div class="series-review-panels">
            <% seriesBetReview.forEach((series, index) => { %>
              <div class="series-review-panel" data-series-review="<%= series.series_key %>" <%= index === 0 ? '' : 'hidden' %>>
                <div class="series-review-overview">
                  <div>
                    <span class="muted">Bets</span>
                    <strong><%= series.bet_count %></strong>
                  </div>
                  <div>
                    <span class="muted">Amount wagered</span>
                    <strong><%= Number(series.total_stake || 0).toLocaleString() %></strong>
                  </div>
                  <div>
                    <span class="muted">Amount won</span>
                    <strong><%= Number(series.total_payout || 0).toLocaleString() %></strong>
                  </div>
                  <div>
                    <span class="muted">Markets</span>
                    <strong><%= series.groups.length %></strong>
                  </div>
                </div>

                <% if (series.groups.length) { %>
                  <div class="series-review-list">
                    <% series.groups.forEach(group => { %>
                      <details class="series-review-market">
                        <summary>
                          <div class="series-review-market-title">
                            <span class="pill"><%= group.bet_kind === 'prop' ? 'Prop' : 'Series' %></span>
                            <strong><%= group.label %></strong>
                          </div>
                          <div class="series-review-market-totals">
                            <span><strong><%= group.bet_count %></strong> bet<%= group.bet_count === 1 ? '' : 's' %></span>
                            <span><strong><%= Number(group.total_stake || 0).toLocaleString() %></strong> wagered</span>
                            <% if (group.settled_count) { %>
                              <span><strong><%= Number(group.total_payout || 0).toLocaleString() %></strong> won</span>
                            <% } %>
                            <% if (group.open_count) { %>
                              <span class="muted"><%= group.open_count %> open</span>
                            <% } %>
                          </div>
                        </summary>

                        <div class="table-wrap series-review-bets">
                          <table>
                            <thead>
                              <tr>
                                <th>User</th>
                                <th>Wagered</th>
                                <th>Odds</th>
                                <th>Status</th>
                                <th>Amount won</th>
                              </tr>
                            </thead>
                            <tbody>
                              <% group.bets.forEach(bet => { %>
                                <tr>
                                  <td><%= bet.user_display_name %></td>
                                  <td><%= Number(bet.stake || 0).toLocaleString() %></td>
                                  <td><%= Number(bet.multiplier || 0) %>x</td>
                                  <td>
                                    <% if (bet.status === 'settled') { %>
                                      <span class="<%= bet.won ? 'positive' : 'negative' %>"><%= bet.won ? 'Won' : 'Lost' %></span>
                                    <% } else { %>
                                      <span class="muted">Open</span>
                                    <% } %>
                                  </td>
                                  <td><%= bet.status === 'settled' ? Number(bet.payout || 0).toLocaleString() : '—' %></td>
                                </tr>
                              <% }) %>
                            </tbody>
                          </table>
                        </div>
                      </details>
                    <% }) %>
                  </div>
                <% } else { %>
                  <p class="muted series-review-empty">No bets involve this series yet.</p>
                <% } %>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <p class="muted">No series are scheduled for Week <%= currentWeek %>.</p>
        <% } %>
      </div>
    </section>


    <section class="card admin-card">
      <div class="admin-section-head">
        <h2>Void / Refund Tools · Week <%= currentWeek %></h2>
        <button type="button" class="button-link ghost admin-collapse-toggle" data-target="adminVoidRefundBody">Show</button>
      </div>
      <div id="adminVoidRefundBody" class="admin-collapsible-body" hidden>
      <p class="muted">Use this before moving a postponed series out of the week in the main WCPL schedule. It refunds matching open series bets plus prop bets on players from either team.</p>

      <form method="post" action="/admin/void-series" class="admin-inline-form" onsubmit="return confirm('Void/refund all open bets tied to this series, including props for players on both teams?');">
        <input type="hidden" name="week" value="<%= currentWeek %>">
        <label>
          Postponed series
          <select name="series_key" required>
            <option value="">Select series...</option>
            <% currentWeekSeries.forEach(s => { %>
              <option value="<%= s.series_key %>"><%= s.division_name %> · <%= s.away_team_name %> at <%= s.home_team_name %></option>
            <% }) %>
          </select>
        </label>
        <button type="submit">Void Series + Team Props</button>
      </form>

      <% if (voidRefunds && voidRefunds.length) { %>
        <h3>Current Week Void/Refund Recap</h3>
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>User</th>
                <th>Refund</th>
                <th>Reason</th>
                <th>Time</th>
              </tr>
            </thead>
            <tbody>
              <% voidRefunds.forEach(v => { %>
                <tr>
                  <td><%= v.user_display_name %></td>
                  <td><%= v.amount %></td>
                  <td><%= v.note %></td>
                  <td><%= new Date(v.created_at).toLocaleString() %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <p class="muted">No Week <%= currentWeek %> void/refund actions yet.</p>
      <% } %>
      </div>
    </section>

    <section class="card admin-card">
      <div class="admin-section-head">
        <h2>Settlement Preview · Week <%= currentWeek %></h2>
        <button type="button" class="button-link ghost admin-collapse-toggle" data-target="adminSettlementPreviewBody">Show</button>
      </div>
      <div id="adminSettlementPreviewBody" class="admin-collapsible-body" hidden>
      <% if (settlementPreview && settlementPreview.error) { %>
        <p class="negative">Unable to build settlement preview: <%= settlementPreview.error %></p>
      <% } else if (settlementPreview) { %>
        <p class="muted">
          Ready: <strong class="<%= settlementPreview.ready ? 'positive' : 'negative' %>"><%= settlementPreview.ready ? 'Yes' : 'No' %></strong> ·
          Winners: <strong><%= settlementPreview.winners %></strong> ·
          Losers: <strong><%= settlementPreview.losers %></strong> ·
          Skipped: <strong><%= settlementPreview.skipped %></strong> ·
          Payout: <strong><%= settlementPreview.payoutTotal %></strong> Mushybux
        </p>

        <div class="admin-action-row">
          <form method="post" action="/admin/settle-completed" class="admin-danger-zone" onsubmit="return confirm('Settle every currently resolved Week <%= currentWeek %> bet? Unresolved bets will stay in the preview.');">
            <input type="hidden" name="week" value="<%= currentWeek %>">
            <div>
              <strong>Settle Completed Bets</strong>
              <p class="muted">Pays only bets that are resolved right now. Settled bets disappear from this preview.</p>
            </div>
            <button type="submit">Settle Completed Bets</button>
          </form>

          <form method="post" action="/admin/settle-week" class="admin-danger-zone" onsubmit="return confirm('Settle every open Week <%= currentWeek %> bet? This only works when the entire week is ready.');">
            <input type="hidden" name="week" value="<%= currentWeek %>">
            <div>
              <strong>Settle Entire Week</strong>
              <p class="muted">Only enabled when every open Week <%= currentWeek %> bet is complete.</p>
            </div>
            <button type="submit" <%= settlementPreview.ready ? '' : 'disabled' %>>Settle Entire Week</button>
          </form>
        </div>

        <% if (settlementPreview.rows.length) { %>
          <div class="settlement-preview-controls">
            <label>
              Sort preview
              <select id="settlementPreviewSort">
                <option value="original">Original order</option>
                <option value="ready">Complete first</option>
                <option value="incomplete">Incomplete first</option>
                <option value="result">Win/Loss/Incomplete</option>
                <option value="payout_desc">Payout high to low</option>
                <option value="stake_desc">Stake high to low</option>
                <option value="stake_asc">Stake low to high</option>
                <option value="user_asc">User A-Z</option>
                <option value="bet_asc">Bet A-Z</option>
              </select>
            </label>
            <label class="settlement-preview-checkbox">
              <input type="checkbox" id="settlementPreviewHideIncomplete">
              Hide incomplete bets
            </label>
          </div>

          <div class="table-wrap">
            <table id="settlementPreviewTable">
              <thead>
                <tr>
                  <th>User</th>
                  <th>Bet</th>
                  <th>Stake</th>
                  <th>Odds</th>
                  <th>Result</th>
                  <th>Payout</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody>
                <% settlementPreview.rows.forEach((r, idx) => { %>
                  <tr
                    data-original-index="<%= idx %>"
                    data-ready="<%= r.ready ? '1' : '0' %>"
                    data-won="<%= r.ready ? (r.won ? '1' : '0') : '' %>"
                    data-user="<%= r.user_display_name %>"
                    data-bet="<%= r.label %>"
                    data-stake="<%= Number(r.stake || 0) %>"
                    data-multiplier="<%= Number(r.multiplier || 0) %>"
                    data-payout="<%= Number(r.payout || 0) %>"
                  >
                    <td><%= r.user_display_name %></td>
                    <td><%= r.label %></td>
                    <td><%= r.stake %></td>
                    <td><%= r.multiplier %>x</td>
                    <td>
                      <% if (!r.ready) { %>
                        <span class="negative">Incomplete</span>
                      <% } else if (r.won) { %>
                        <span class="positive">Win</span>
                      <% } else { %>
                        <span class="negative">Loss</span>
                      <% } %>
                      <br><small class="muted"><%= r.result_summary || r.evaluation_reason %></small>
                    </td>
                    <td><%= r.payout %></td>
                    <td>
                      <form method="post" action="/admin/refund-bet" onsubmit="return confirm('Refund and void this bet?');">
                        <input type="hidden" name="bet_id" value="<%= r.id %>">
                        <button type="submit" class="ghost small-button">Refund</button>
                      </form>
                    </td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } else { %>
          <p class="muted">No open Week <%= currentWeek %> bets to settle.</p>
        <% } %>
      <% } %>
      </div>
    </section>

    <section class="card admin-card">
      <div class="admin-section-head">
        <h2>User Balances & Details</h2>
        <button type="button" class="button-link ghost admin-collapse-toggle" data-target="adminUserBalancesBody">Show</button>
      </div>
      <div id="adminUserBalancesBody" class="admin-collapsible-body" hidden>
      <form method="post" action="/admin/adjust-all-balances" class="admin-bulk-balance-form" onsubmit="return confirm(`Apply ${this.amount.value} Mushybux to ALL <%= users.length %> users?`);">
        <div>
          <strong>Adjust All User Balances</strong>
          <p class="muted small-note">Use a positive amount to add Mushybux or a negative amount to subtract it.</p>
        </div>
        <input type="number" name="amount" step="1" placeholder="+/- Mushybux each" required>
        <input type="text" name="note" placeholder="Reason (optional)">
        <button type="submit">Adjust All Users</button>
      </form>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>User Details</th>
              <th>Total (Wagered)</th>
              <th>Available</th>
              <th>Adjust Balance</th>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(u => { %>
              <tr>
                <td>
                  <form method="post" action="/admin/update-user" class="admin-user-edit-form">
                    <input type="hidden" name="user_id" value="<%= u.id %>">
                    <input type="text" name="display_name" value="<%= u.display_name %>" placeholder="Display name" required>
                    <input type="text" name="username" value="<%= u.username %>" placeholder="Username" required>
                    <input type="text" name="password" placeholder="New password (blank = keep)">
                    <select name="role">
                      <option value="user" <%= u.role === 'user' ? 'selected' : '' %>>User</option>
                      <option value="admin" <%= u.role === 'admin' ? 'selected' : '' %>>Admin</option>
                    </select>
                    <button type="submit">Save</button>
                  </form>
                </td>
                <td><strong><%= u.balance_display %></strong></td>
                <td><%= u.available_balance %></td>
                <td>
                  <form method="post" action="/admin/adjust-balance" class="admin-balance-adjust-form">
                    <input type="hidden" name="user_id" value="<%= u.id %>">
                    <input type="number" name="amount" step="1" placeholder="+/- Mushybux" required>
                    <input type="text" name="note" placeholder="Reason (optional)">
                    <button type="submit">Adjust</button>
                  </form>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
      </div>
    </section>

    <section class="card admin-card" id="series-odds-recommendations">
      <div class="admin-section-head">
        <h2><%= oddsWeekMode === 'current' ? 'Current Week' : 'Next Week' %> Series Odds Recommendations · Week <%= oddsWeek %></h2>
        <button type="button" class="button-link ghost admin-collapse-toggle" data-target="adminSeriesRecommendationsBody">Show</button>
      </div>
      <div id="adminSeriesRecommendationsBody" class="admin-collapsible-body" hidden>
        <div class="toggle-row admin-odds-week-toggle">
          <a class="button-link <%= oddsWeekMode === 'next' ? 'ghost-active' : 'ghost' %>" href="/admin?odds_week=next#series-odds-recommendations">Next Week</a>
          <a class="button-link <%= oddsWeekMode === 'current' ? 'ghost-active' : 'ghost' %>" href="/admin?odds_week=current#series-odds-recommendations">Current Week Override</a>
        </div>
        <% if (oddsWeekMode === 'current') { %>
          <p class="negative small-note">Current-week changes immediately reprice matching open bets. Use this only to correct lines before betting locks.</p>
        <% } %>
        <p class="muted">
          Model preview using S1/S2 player history and completed S3 games before Week <%= oddsWeek %>.
          Review every editable value, then apply the entire section once.
        </p>
        <form id="bulkSeriesOddsForm" method="post" action="/admin/odds/bulk-series" data-bulk-series-form>
          <input type="hidden" name="week" value="<%= oddsWeek %>">
          <input type="hidden" name="payload" value="">
        </form>

        <% if (seriesOddsRecommendations && seriesOddsRecommendations.error) { %>
          <p class="negative">Unable to build recommendations: <%= seriesOddsRecommendations.error %></p>
        <% } else if (!seriesOddsRecommendations || !seriesOddsRecommendations.recommendations.length) { %>
          <p class="muted">No Week <%= oddsWeek %> series found.</p>
        <% } else { %>
          <div class="odds-model-summary">
            <span><strong><%= Math.round(seriesOddsRecommendations.xgWeight * 100) %>%</strong> xG</span>
            <span><strong><%= seriesOddsRecommendations.teamPriorGames %></strong>-game prior</span>
            <span><strong><%= Math.round(seriesOddsRecommendations.probabilityShrinkage * 100) %>%</strong> probability shrink</span>
            <span><strong>+<%= seriesOddsRecommendations.goalCalibration.toFixed(2) %></strong> goal calibration</span>
            <span><strong><%= seriesOddsRecommendations.sweepCorrectionFactor.toFixed(1) %>x</strong> sweep correction</span>
          </div>

          <div class="odds-recommendation-grid">
            <% seriesOddsRecommendations.recommendations.forEach(rec => { %>
              <article class="odds-recommendation-card">
                <form method="post" action="/admin/odds/series" data-series-odds-form>
                  <input type="hidden" name="week" value="<%= oddsWeek %>">
                  <input type="hidden" name="series_key" value="<%= rec.seriesKey %>">
                <div class="odds-recommendation-head">
                  <div>
                    <span class="pill"><%= rec.divisionId %></span>
                    <h3><%= rec.awayTeamName %> at <%= rec.homeTeamName %></h3>
                  </div>
                  <span class="odds-confidence odds-confidence-<%= rec.confidence.toLowerCase() %>"><%= rec.confidence %> confidence</span>
                </div>

                <div class="odds-projection-strip">
                  <div>
                    <span><%= rec.awayTeamName %></span>
                    <strong><%= (rec.away.seriesWinProbability * 100).toFixed(1) %>%</strong>
                    <small><%= rec.awayExpectedGoalsPerGame.toFixed(2) %> goals/game</small>
                  </div>
                  <div class="odds-projection-vs">VS</div>
                  <div>
                    <span><%= rec.homeTeamName %></span>
                    <strong><%= (rec.home.seriesWinProbability * 100).toFixed(1) %>%</strong>
                    <small><%= rec.homeExpectedGoalsPerGame.toFixed(2) %> goals/game</small>
                  </div>
                </div>

