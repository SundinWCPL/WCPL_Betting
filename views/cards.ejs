<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>WUT</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <%- include('partials_header') %>
  <%
    const playerName = (match, id) => match.players.find(player => Number(player.id) === Number(id))?.displayName || 'Player';
    const committedCount = (match, userId) => match.placements.filter(row => Number(row.user_id) === Number(userId)).length;
  %>
  <main class="container cards-page arena-page">
    <section class="card page-title cards-title">
      <div><p class="eyebrow">Asynchronous head-to-head</p><h1>WUT</h1><p>Build a five-card lineup, assign boosts, and go head-to-head.</p></div>
      <div class="cards-title-actions"><span class="cards-balance"><%= Math.ceil(wutCoins) %> WUT Coins</span><% if (wutMembership.starterOpened) { %><span class="pill">ELO <%= arena.rating %></span><span class="pill">Record <%= arena.record.wins %>-<%= arena.record.losses %><%= arena.record.draws ? `-${arena.record.draws}` : '' %></span><% } %><a class="button-link ghost" href="/cards/guide">How to Play</a><% if (cardsOpen && wutMembership.starterOpened) { %><a class="button-link ghost" href="/cards/drafts">Draft Events</a><a class="button-link ghost" href="/cards/collection">Collection</a><a class="button-link" href="/cards/store">WUT Shop</a><% } %></div>
    </section>

    <% if (!cardsOpen) { %>
      <section class="card casino-closed-notice">
        <strong>WUT is temporarily closed.</strong>
        <span>Collections, the shop, matches, queue entries, and matchmaking are paused until an admin reopens WUT.</span>
      </section>
    <% } else if (!wutMembership.joined) { %>
      <section class="card arena-queue-card wut-onboarding-card">
        <div><p class="eyebrow">First-time entry</p><h2>Join WUT</h2><p class="muted">Unlock WUT and receive five unique Common players (2F / 2D / 1G), two random Common trinkets, and one free Standard pack.</p></div>
        <form method="post" action="/cards/wut/join"><button>Join WUT Free</button></form>
      </section>
    <% } else if (!wutMembership.starterOpened) { %>
      <section class="card arena-queue-card wut-onboarding-card">
        <div><p class="eyebrow">Membership active</p><h2>Your starter bundle is ready</h2><p class="muted">Inside: five unique Common players (2F / 2D / 1G), two random Common trinkets, and 1,000 WUT Coins. Your free Standard pack will be waiting in the WUT Shop.</p></div>
        <form method="post" action="/cards/wut/starter-pack"><button>Open Starter Pack</button></form>
      </section>
    <% } else { %>
    <% if (currentUser.role === 'admin') { %>
      <details class="card arena-admin" id="arena-admin">
        <summary><span><strong>Admin WUT Testing</strong><small><%= adminArena.queued %> waiting · <%= adminArena.active %> active</small></span></summary>
        <div class="arena-admin-body">
          <p class="muted">Run matchmaking early, or rebuild every rating by replaying completed matches from oldest to newest.</p>
          <div class="admin-action-row">
            <form method="post" action="/cards/arena/admin/match"><button>Run Matchmaking Now</button></form>
            <form method="post" action="/cards/arena/admin/recalculate-elo" onsubmit="return confirm('Reset every ELO to 1000 and replay all completed WUT matches oldest to newest?');"><button>Recalculate All ELO</button></form>
            <a class="button-link" href="/cards/arena/debug">Open Admin Debug Game</a>
          </div>
        </div>
      </details>
    <% } %>

    <section class="card wut-missions" id="missions">
      <div class="cards-section-head"><div><p class="eyebrow">Earn WUT Coins</p><h2>Daily & Weekly Missions</h2><p class="muted">Completed missions wait here until you claim them.</p></div><span class="pill"><%= [...(wut.missions?.daily || []), ...(wut.missions?.weekly || [])].filter(mission => mission.complete && !mission.claimed).length %> ready</span></div>
      <div class="wut-mission-columns">
        <% [['Daily', wut.missions?.daily || []], ['Weekly', wut.missions?.weekly || []]].forEach(([label, missions]) => { %>
          <section class="wut-mission-group">
            <div class="wut-mission-group-title"><h3><%= label %></h3><small><%= label === 'Daily' ? wut.missions?.dayKey : `Week ${String(wut.missions?.weekKey || '').split('|').pop()}` %></small></div>
            <% if (!missions.length) { %><p class="muted">No eligible <%= label.toLowerCase() %> missions are active for the current schedule.</p><% } %>
            <% missions.forEach(mission => { %>
              <article class="wut-mission <%= mission.complete ? 'is-complete' : '' %> <%= mission.claimed ? 'is-claimed' : '' %> <%= mission.failed ? 'is-failed' : '' %>">
                <div class="wut-mission-copy"><strong><%= mission.title %><% if (mission.rotating) { %><small>Rotating</small><% } %></strong><span><%= mission.description %></span></div>
                <div class="wut-mission-progress"><progress value="<%= mission.progress %>" max="<%= mission.target %>"></progress><small><%= mission.progressLabel || `${mission.progress}/${mission.target}` %></small></div>
                <div class="wut-mission-reward"><strong>+<%= mission.reward %></strong><span>WUT Coins</span></div>
                <% if (mission.claimed) { %><span class="pill">Claimed</span><% } else if (mission.failed) { %><span class="pill negative">Failed</span><% } else { %>
                  <form method="post" action="/cards/missions/claim"><input type="hidden" name="period" value="<%= mission.period %>"><input type="hidden" name="mission_id" value="<%= mission.id %>"><button <%= mission.complete ? '' : 'disabled' %>><%= mission.complete ? 'Claim' : 'In Progress' %></button></form>
                <% } %>
              </article>
            <% }) %>
          </section>
        <% }) %>
      </div>
    </section>

    <section class="card arena-queue-card">
      <div><p class="eyebrow">Always-open Queue · <%= arena.queueCount %> <%= arena.queueCount === 1 ? 'person' : 'people' %> waiting · Next run <span data-queue-countdown data-matchmaking-at="<%= arena.nextMatchmakingAt %>">--:--:--</span></p><h2><%= arena.queuedEntry ? 'You’re In' : 'Choose a Deck & Queue' %></h2><p class="muted"><%= arena.queuedEntry ? `Queued with ${arena.queuedEntry.deck_name}. Its snapshot is locked.` : `Winner ${wut.config.rewards.winner} · loser ${wut.config.rewards.loser} WUT Coins · timeout loser 0` %></p></div>
      <% if (!arena.queuedEntry) { %><form method="post" action="/cards/arena/enter"><select name="deck_id" required><option value="">Select saved deck</option><% wut.decks.forEach(deck => { %><option value="<%= deck.id %>"><%= deck.name %></option><% }) %></select><button <%= arena.activeMatches.length >= arena.config.maxActiveMatches || !wut.decks.length ? 'disabled' : '' %>>Enter Queue Free</button></form><% } else { %><span class="pill">Waiting for matchmaking</span><% } %>
    </section>

    <section class="card arena-active-section">
      <div class="cards-section-head arena-active-head">
        <div class="arena-active-title"><div><p class="eyebrow">Your match board</p><h2>Active Matches</h2></div></div>
        <div class="arena-active-actions"><a class="button-link ghost" href="/cards/arena/history">Match History</a><span class="pill"><%= arena.activeMatches.length + arena.readyMatches.length %>/<%= arena.config.maxActiveMatches %> active</span></div>
      </div>
      <div class="arena-match-cards">
        <% [...arena.readyMatches, ...arena.activeMatches].forEach(match => { const isReady = match.status === 'ready'; %>
          <a class="arena-match-link <%= isReady ? 'is-ready' : match.is_your_turn ? 'is-your-turn' : '' %>" href="/cards/arena/matches/<%= match.id %>">
            <span class="arena-match-number">Match #<%= match.id %></span>
            <h3>vs <%= match.opponent.displayName %> <small>· <%= match.opponent.elo %> ELO</small></h3>
            <div class="arena-match-progress"><span>You <strong><%= committedCount(match, currentUser.id) %>/5</strong></span><span><%= match.opponent.displayName %> <strong><%= committedCount(match, match.opponent.id) %>/5</strong></span></div>
            <strong class="arena-match-callout"><%= isReady ? 'Lineups Locked — Show Results' : match.is_your_turn ? `Your turn · place ${match.cards_required_this_turn}` : `${playerName(match, match.current_player_id)} is choosing` %></strong>
            <% if (match.turn_deadline) { %><small data-deadline="<%= match.turn_deadline %>" data-paused="<%= match.timer_paused ? '1' : '0' %>"></small><% } %>
          </a>
        <% }) %>
        <% if (!arena.activeMatches.length && !arena.readyMatches.length) { %><div class="arena-empty"><h3>No active matches</h3><p class="muted">Enter the queue and your next matchup will land here.</p></div><% } %>
      </div>
    </section>
    <% if (arena.cancelledMatches?.length) { %><section class="card"><div class="cards-section-head"><div><p class="eyebrow">No rewards · no ELO change</p><h2>Cancelled Matches</h2></div></div><% arena.cancelledMatches.slice(0, 5).forEach(match => { %><p>Match #<%= match.id %> vs <%= match.opponent.displayName %> was cancelled<%= match.cancel_reason === 'admin_void' ? ` by an administrator${match.cancel_note ? `: ${match.cancel_note}` : '.'}` : ' after the opening turn timed out.' %></p><% }) %></section><% } %>
    <% } %>

    <section class="card arena-elo-leaderboard" id="elo-leaderboard">
      <div class="cards-section-head">
        <div><p class="eyebrow">Skill standings</p><h2>ELO Leaderboard</h2></div>
        <span class="pill"><%= arena.leaderboard.length %> ranked</span>
      </div>
      <% if (!arena.leaderboard.length) { %>
        <p class="muted">Completed WUT matches will populate the leaderboard.</p>
      <% } else { %>
        <div class="table-scroll">
          <table>
            <thead><tr><th>Rank</th><th>Player</th><th>ELO</th><th>Record</th><th>Matches</th></tr></thead>
            <tbody>
              <% arena.leaderboard.forEach(entry => { %>
                <tr class="<%= Number(entry.userId) === Number(currentUser.id) ? 'is-current-user' : '' %>">
                  <td><strong>#<%= entry.rank %></strong></td>
                  <td><%= entry.displayName %></td>
                  <td><strong><%= entry.rating %></strong></td>
                  <td><%= entry.wins %>-<%= entry.losses %><%= entry.draws ? `-${entry.draws}` : '' %></td>
                  <td><%= entry.matches %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } %>
    </section>
  </main>
  <script>
    const queueCountdown = document.querySelector('[data-queue-countdown]');
    if (queueCountdown) {
      const serverOffset = new Date('<%= arena?.serverNow || new Date().toISOString() %>').getTime() - Date.now();
      const updateQueueCountdown = () => {
        const seconds = Math.max(0, Math.floor((new Date(queueCountdown.dataset.matchmakingAt).getTime() - (Date.now() + serverOffset)) / 1000));
        const hours = Math.floor(seconds / 3600);
        const minutes = Math.floor((seconds % 3600) / 60);
        const remainder = seconds % 60;
        queueCountdown.textContent = `${String(hours).padStart(2, '0')}:${String(minutes).padStart(2, '0')}:${String(remainder).padStart(2, '0')}`;
      };
      updateQueueCountdown();
      setInterval(updateQueueCountdown, 1000);
    }
    document.querySelectorAll('[data-deadline]').forEach(el => {
      const update = () => { if (el.dataset.paused === '1') return el.textContent = 'Timer paused overnight · play is still allowed'; const remaining = new Date(el.dataset.deadline).getTime() - Date.now(); if (remaining <= 0) return el.textContent = 'Timeout processing'; const hours = Math.floor(remaining / 3600000); const minutes = Math.floor((remaining % 3600000) / 60000); el.textContent = `${hours}h ${minutes}m remaining`; };
      update(); setInterval(update, 60000);
    });
    if (document.querySelector('.arena-match-link:not(.is-your-turn):not(.is-ready)') && !document.querySelector('.arena-match-link.is-your-turn')) setTimeout(() => window.location.reload(), 30000);
  </script>
</body>
</html>
