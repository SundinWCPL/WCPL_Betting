<%
  const visualFantasy = card?.fantasyAppearances || { gamesPlayed: 0, fp: 0, stats: {} };
  const visualWutMatches = card?.wutMatchStats || { matchesPlayed: 0, fp: 0, fpPerMatch: 0 };
  const visualStats = visualFantasy.stats || {};
  const visualPlayer = card?.player || {};
  const visualEdition = String(visualPlayer.edition || '').trim().toUpperCase();
  const visualCardArt = String(visualPlayer.cardArt || visualPlayer.card_art || card?.card_art || visualEdition || 'S3').trim().toUpperCase();
  const visualEditionStats = visualPlayer.editionStats || visualPlayer.seasonStats?.[visualPlayer.edition] || {};
  const visualRarityRank = { common: 1, uncommon: 2, rare: 3, epic: 4, legendary: 5, mythic: 6 };
  const visualTrinketIcons = WUT_TRINKET_ICONS;
  const visualTrinketEffectText = wutTrinketDescription;
  const visualTitleCase = value => String(value || '').replace(/_/g, ' ').replace(/\b\w/g, char => char.toUpperCase());
  const visualTrinketName = wutTrinketName;
  const visualName = (() => {
    const edition = String(visualPlayer.edition || '').trim();
    const name = String(visualPlayer.name || '').trim();
    return edition && name.toUpperCase().startsWith(`${edition.toUpperCase()} `) ? name.slice(edition.length).trim() : name;
  })();
  const visualPrintedTeamLogo = visualPlayer.teamLogo || '';
  const visualTeamLogo = card?.matchTeamLogo || visualPrintedTeamLogo;
  const visualTeamBgColor = card?.matchTeamBgColor || visualPlayer.teamBgColor;
  const visualTeamName = card?.matchTeamName || visualPlayer.teamDisplayName || visualPlayer.teamName || visualPlayer.teamId || 'Team';
  const visualSeason = visualPlayer.cardType === 'mythic'
    ? `${visualPlayer.sourceSeason || ''}${String(visualPlayer.sourceStage || '').toLowerCase() === 'playoffs' ? ' PO' : ''}`
    : visualPlayer.edition;
  const visualStatus = statusText || 'Available for WUT';
%>
<div class="arena-wut-card-inner">
  <div class="arena-wut-card-face wut-card-face wut-card-front" data-card-edition="<%= visualCardArt %>">
    <% if (card?.power) { %><span class="wut-power-badge" title="Power = card rarity value + trinket Power. Cards: Common 1 · Uncommon 2 · Rare 3 · Epic 4 · Legendary 5 · Mythic 6. Trinkets: Common +0 · Uncommon +0.5 · Rare +1 · Epic +1.5 · Legendary +2.5. Boosts add no Power.">P<%= card.power %></span><% } %>
    <% if (card?.trinket) { %><span class="wut-trinket-badge tier-<%= card.trinket.rarity %>" data-trinket-family="<%= card.trinket.family %>" title="<%= visualTrinketName(card.trinket.family) %> · <%= visualTitleCase(card.trinket.rarity) %> · +<%= wutTrinketPower(card.trinket.rarity) %> Power
<%= visualTrinketEffectText(card.trinket) %>"><%= wutTrinketIcon(card.trinket) %></span><% } %>
    <div class="wut-front-badge <%= visualPlayer.cardType === 'mythic' ? 'is-position-only' : '' %>">
      <% if (visualPlayer.cardType !== 'mythic') { %><span><%= visualPlayer.edition %></span><% } %>
      <strong><%= visualPlayer.position %></strong>
    </div>
    <div class="wut-front-copy">
      <strong class="player-card-name"><%= visualName %></strong>
      <span class="wut-front-stat">MP: <%= visualWutMatches.matchesPlayed || 0 %> - FP/M: <%= Number(visualWutMatches.fpPerMatch || 0).toFixed(1) %></span>
    </div>
    <% if (visualPrintedTeamLogo) { %><img class="wut-front-logo <%= card?.matchTeamLogo ? 'wut-front-logo-original' : '' %>" src="<%= visualPrintedTeamLogo %>" alt="" style="--team-bg:<%= visualPlayer.teamBgColor %>"><% } %>
    <% if (card?.matchTeamLogo) { %><img class="wut-front-logo wut-front-logo-adopted" src="<%= visualTeamLogo %>" alt="" style="--team-bg:<%= visualTeamBgColor %>"><% } %>
  </div>
  <div class="arena-wut-card-face arena-wut-card-back wut-card-face wut-card-back" data-card-edition="<%= visualCardArt %>">
    <div class="wut-back-header">
      <strong><%= visualName %></strong>
      <span><%= visualTitleCase(visualPlayer.tier) %> <small><%= '★'.repeat(Number(visualPlayer.stars || visualRarityRank[visualPlayer.tier] || 1)) %></small></span>
    </div>
    <div class="wut-stat-panel <%= visualPlayer.cardType === 'mythic' ? 'is-mythic' : '' %>">
      <% if (visualPlayer.cardType !== 'mythic') { %>
        <table class="card-history-table">
          <% if (visualPlayer.position === 'G') { %>
            <thead><tr><th>Season</th><th>GP</th><th>SV%</th><th>SO</th></tr></thead>
            <tbody><tr><td><%= visualSeason %></td><td><%= visualEditionStats.games || 0 %></td><td><%= visualEditionStats.savePct ? (visualEditionStats.savePct * 100).toFixed(1) : 'N/A' %></td><td><%= visualEditionStats.shutouts || 0 %></td></tr></tbody>
          <% } else { %>
            <thead><tr><th>Season</th><th>GP</th><th>G</th><th>A</th><th>SH</th><th>HIT</th><th>BLK</th></tr></thead>
            <tbody><tr><td><%= visualSeason %></td><td><%= visualEditionStats.games || 0 %></td><td><%= visualEditionStats.goals || 0 %></td><td><%= visualEditionStats.assists || 0 %></td><td><%= visualEditionStats.shots || 0 %></td><td><%= visualEditionStats.hits == null ? 'N/A' : visualEditionStats.hits %></td><td><%= visualEditionStats.blocks == null ? 'N/A' : visualEditionStats.blocks %></td></tr></tbody>
          <% } %>
        </table>
      <% } %>
      <div class="fantasy-appearances">
        <strong>WUT Stats</strong>
        <% if (visualPlayer.position === 'G') { %>
          <table class="card-history-table"><thead><tr><th>GP</th><th>SV</th><th>SV%</th><th>SO</th><th>FP</th></tr></thead><tbody><tr><td><%= visualFantasy.gamesPlayed || 0 %></td><td><%= visualStats.saves || 0 %></td><td><%= ((visualStats.savePct || 0) * 100).toFixed(1) %></td><td><%= visualStats.shutouts || 0 %></td><td><%= visualFantasy.fp || 0 %></td></tr></tbody></table>
        <% } else { %>
          <table class="card-history-table"><thead><tr><th>GP</th><th>G</th><th>A</th><th>SH</th><th>HIT</th><th>BLK</th><th>FP</th></tr></thead><tbody><tr><td><%= visualFantasy.gamesPlayed || 0 %></td><td><%= visualStats.goals || 0 %></td><td><%= visualStats.assists || 0 %></td><td><%= visualStats.shots || 0 %></td><td><%= visualStats.hits || 0 %></td><td><%= visualStats.blocks || 0 %></td><td><%= visualFantasy.fp || 0 %></td></tr></tbody></table>
        <% } %>
      </div>
      <% if (visualPlayer.cardType === 'mythic') { %><small class="wut-mythic-status"><%= visualStatus %></small><% } %>
    </div>
    <% if (visualPlayer.cardType === 'mythic') { %>
      <div class="wut-back-flavor"><span><%= visualPlayer.flavorText || visualStatus %></span></div>
    <% } else { %>
      <div class="wut-back-player"><strong><%= visualTeamName %></strong><small><%= visualStatus %></small><% if (visualTeamLogo) { %><img src="<%= visualTeamLogo %>" alt="" style="--team-bg:<%= visualTeamBgColor %>"><% } %></div>
    <% } %>
  </div>
</div>
