<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Your Card Collection</title>
  <link rel="stylesheet" href="/style.css">
  <script src="/card-name-fit.js" defer></script>
</head>
<body>
  <%- include('partials_header') %>
  <%
    const titleCase = wutTitleCase;
    const trinketName = wutTrinketName;
    const trinketIcons = WUT_TRINKET_ICONS;
    const trinketEffectText = wutTrinketDescription;
    const trinketTooltip = item => `${trinketName(item.family)} · ${titleCase(item.rarity)} · +${wut.config.trinketPowerValues[item.rarity]} Power\n${trinketEffectText(item)}`;
    const statusForCard = card => card.duplicateCopy && card.duplicateSellValue
      ? `Duplicate copy - sell for ${card.duplicateSellValue} WUT Coins`
      : `Available for WUT · Power ${card.power || 1}`;
    const availableCollectionBoosts = boosts.filter(boost => !boost.arenaLocked);
    const tradingState = trading || { ownListings: [], marketListings: [], incomingOffers: [], outgoingOffers: [] };
    const tradeableCards = cards.filter(card => !card.tradeListed && !card.arenaLocked);
  %>
  <main class="container cards-page arena-page">
    <section class="card page-title cards-title">
      <div><p class="eyebrow">Owned items</p><h1>Your Collection</h1><p>Browse every player card and boost with season, position, rarity, and availability filters.</p></div>
      <div class="cards-title-actions"><span class="cards-balance"><%= wutCoins %> WUT Coins</span><a class="button-link ghost" href="/cards">← WUT</a><a class="button-link ghost" href="/cards/decks">Decks</a><a class="button-link" href="/cards/store">WUT Shop</a></div>
    </section>

    <section class="card"><div class="cards-section-head"><div><p class="eyebrow">Deck-building inventory</p><h2>Trinket Inventory</h2><p class="muted" id="trinketAttachHelp">Hover for details. Assign trinkets inside a saved deck or Draft Event deck.</p></div><span class="pill"><%= wut.trinkets.length %> owned</span></div><div class="wut-trinket-inventory"><% wut.trinkets.forEach(item => { %><button type="button" class="wut-trinket-inventory-item tier-<%= item.rarity %>" data-trinket-family="<%= item.family %>" data-trinket-id="<%= item.id %>" data-trinket-name="<%= trinketName(item.family) %>" title="<%= trinketTooltip(item) %>"><span class="wut-trinket-icon"><%= trinketIcons[item.family] || '◆' %></span><small><%= trinketName(item.family) %></small><em><%= titleCase(item.rarity) %></em></button><% }) %><% if (!wut.trinkets.length) { %><p class="muted">No trinkets yet. The WUT Shop rotates three offers daily.</p><% } %></div></section>

    <section class="card cards-collection full-collection-page">
      <div class="cards-section-head"><div><p class="eyebrow">Collection browser</p><h2>Cards & Boosts</h2><p class="muted">Card Power: Common 1 · Uncommon 2 · Rare 3 · Epic 4 · Legendary 5 · Mythic 6. Trinkets add 0 / 0.5 / 1 / 1.5 / 2.5 by rarity.</p></div><span class="pill"><%= cards.length %> cards · <%= availableCollectionBoosts.length %> boosts</span></div>
      <div class="collection-progress"><% collectionProgress.forEach(pool => { %><span><strong><%= pool.owned %>/<%= pool.total %></strong> <%= pool.label %></span><% }) %></div>
      <div class="collection-tabs"><button type="button" class="collection-tab is-active" data-collection-tab="players">Player Cards</button><button type="button" class="collection-tab" data-collection-tab="boosts">Boosts</button><button type="button" class="collection-tab" data-collection-tab="trading">Trading</button></div>

      <div class="full-collection-filters" data-filter-panel="players">
        <label class="collection-search">Search<input type="search" placeholder="Player or team" data-card-search></label>
        <label class="check"><input type="checkbox" data-duplicate-filter> Duplicates only</label>
        <fieldset><legend>Season</legend><% ['S1','S2','S3','MYTHIC'].forEach(edition => { %><label><input type="checkbox" data-edition-filter value="<%= edition %>" checked> <%= edition === 'MYTHIC' ? 'Mythic' : edition %></label><% }) %></fieldset>
        <fieldset><legend>Position</legend><% [['F','Forwards'],['D','Defense'],['G','Goalies']].forEach(([position,label]) => { %><label><input type="checkbox" data-position-filter value="<%= position %>" checked> <%= label %></label><% }) %></fieldset>
        <label>Rarity<select data-rarity-filter><option value="">All rarities</option><% ['common','uncommon','rare','epic','legendary','mythic'].forEach(rarity => { %><option value="<%= rarity %>"><%= titleCase(rarity) %></option><% }) %></select></label>
      </div>

      <div class="full-collection-filters" data-filter-panel="boosts" hidden>
        <label class="collection-search">Search<input type="search" placeholder="Boost type" data-boost-search></label>
        <label>Rarity<select data-boost-rarity-filter><option value="">All rarities</option><% ['common','uncommon','rare','epic','legendary'].forEach(rarity => { %><option value="<%= rarity %>"><%= titleCase(rarity) %></option><% }) %></select></label>
        <label>Type<select data-boost-type-filter><option value="">All boost types</option><% ['goal','assist','shot','grit','save','shutout'].forEach(type => { %><option value="<%= type %>"><%= titleCase(type) %></option><% }) %></select></label>
      </div>
      <div class="full-collection-filters" data-filter-panel="trading" hidden>
        <label class="collection-search">Search trades<input type="search" placeholder="Player, team, or owner" data-trade-search></label>
        <fieldset><legend>Position</legend><% [['F','Forwards'],['D','Defense'],['G','Goalies']].forEach(([position,label]) => { %><label><input type="checkbox" data-trade-position-filter value="<%= position %>" checked> <%= label %></label><% }) %></fieldset>
        <label>Rarity<select data-trade-rarity-filter><option value="">All rarities</option><% ['common','uncommon','rare','epic','legendary','mythic'].forEach(rarity => { %><option value="<%= rarity %>"><%= titleCase(rarity) %></option><% }) %></select></label>
      </div>

      <p class="muted collection-result-count" data-result-count></p>
      <div class="collection-grid" data-collection-panel="players">
        <% cards.forEach(card => { const status = 'available'; %>
          <article class="collection-player arena-wut-card arena-collection-card tier-<%= card.player.tier %>" tabindex="0" data-card-id="<%= card.id %>" data-card-name="<%= card.player.name %>" data-position="<%= card.player.position %>" data-edition="<%= card.player.cardType === 'mythic' ? 'MYTHIC' : card.player.edition %>" data-rarity="<%= card.player.tier %>" data-status="available" data-duplicate="<%= card.duplicateCopy ? '1' : '0' %>" data-sell-value="<%= card.duplicateSellValue || 0 %>" data-search="<%= `${card.player.name} ${card.player.teamDisplayName || card.player.teamName || card.player.teamId || ''}`.toLowerCase() %>">
            <%- include('partials_wut_card', { card, statusText: statusForCard(card) }) %>
          </article>
        <% }) %>
      </div>
      <div class="collection-grid arena-boost-collection" data-collection-panel="boosts" hidden>
        <% availableCollectionBoosts.forEach(boost => { %>
          <article class="collection-boost tier-<%= boost.rarity %>" data-rarity="<%= boost.rarity %>" data-type="<%= boost.boost_type %>" data-search="<%= `${boost.rarity} ${boost.boost_type}`.toLowerCase() %>">
            <%- include('partials_boost_content', { boost }) %>
          </article>
        <% }) %>
      </div>
      <div class="wut-trading-panel" data-collection-panel="trading" hidden id="trading">
        <div class="collection-tabs wut-trade-tabs"><button type="button" class="collection-tab is-active" data-trade-tab="mine">My Listings</button><button type="button" class="collection-tab" data-trade-tab="market">Trade Market</button><button type="button" class="collection-tab" data-trade-tab="offers">Offers</button></div>
        <section data-trade-panel="mine">
          <div class="cards-section-head"><div><h3>Your Listed Cards</h3><p class="muted">These player cards can be offered in 1-for-1 same-rarity trades.</p></div><span class="pill" data-own-listing-count><%= tradingState.ownListings.length %> listed</span></div>
          <div class="collection-grid wut-trade-grid" data-own-trade-grid>
            <% tradingState.ownListings.forEach(listing => { const card = listing.card; %><article class="wut-trade-card tier-<%= card.player.tier %>" data-own-trade-card="listed" data-card-id="<%= card.id %>" data-listing-id="<%= listing.id %>" data-rarity="<%= listing.rarity %>" data-card-name="<%= card.player.name %>"><div class="arena-wut-card arena-collection-card tier-<%= card.player.tier %>"><%- include('partials_wut_card', { card, statusText: `Listed for ${titleCase(listing.rarity)} trades` }) %></div><form method="post" action="/cards/trading/unlist" data-trade-unlist-form><input type="hidden" name="listing_id" value="<%= listing.id %>"><button class="ghost">Unlist</button></form></article><% }) %>
            <p class="muted" data-trade-empty="listed" <%= tradingState.ownListings.length ? 'hidden' : '' %>>You have not listed any cards yet.</p>
          </div>
          <div class="cards-section-head"><div><h3>Available for Trading</h3><p class="muted">List an unused player card without leaving this page.</p></div><span class="pill" data-available-trade-count><%= tradeableCards.length %> available</span></div>
          <div class="collection-grid wut-trade-grid" data-available-trade-grid>
            <% tradeableCards.forEach(card => { %><article class="wut-trade-card tier-<%= card.player.tier %>" data-own-trade-card="available" data-card-id="<%= card.id %>" data-rarity="<%= card.player.tier %>" data-card-name="<%= card.player.name %>"><div class="arena-wut-card arena-collection-card tier-<%= card.player.tier %>"><%- include('partials_wut_card', { card, statusText: `List for ${titleCase(card.player.tier)} trades` }) %></div><form method="post" action="/cards/trading/list" data-trade-list-form><input type="hidden" name="card_id" value="<%= card.id %>"><button>List for Trade</button></form></article><% }) %>
            <p class="muted" data-trade-empty="available" <%= tradeableCards.length ? 'hidden' : '' %>>No unlisted player cards available.</p>
          </div>
        </section>
        <section data-trade-panel="market" hidden>
          <div class="cards-section-head"><div><h3>Trade Market</h3><p class="muted">Click a card to offer one of your listed cards of the same rarity.</p></div><span class="pill"><%= tradingState.marketListings.length %> cards</span></div>
          <div class="collection-grid wut-trade-grid" data-trade-market-grid>
            <% tradingState.marketListings.forEach(listing => { const card = listing.card; %><article class="wut-trade-card tier-<%= card.player.tier %>" tabindex="0" title="Offered by <%= listing.owner_display_name %>" data-trade-market-card data-listing-id="<%= listing.id %>" data-rarity="<%= listing.rarity %>" data-card-name="<%= card.player.name %>" data-owner="<%= listing.owner_display_name %>" data-position="<%= card.player.position %>" data-search="<%= `${card.player.name} ${card.player.teamDisplayName || card.player.teamName || card.player.teamId || ''} ${listing.owner_display_name}`.toLowerCase() %>"><div class="arena-wut-card arena-collection-card tier-<%= card.player.tier %>"><%- include('partials_wut_card', { card, statusText: `Offered by ${listing.owner_display_name}` }) %></div></article><% }) %>
            <% if (!tradingState.marketListings.length) { %><p class="muted">No cards are listed by other users yet.</p><% } %>
          </div>
        </section>
        <section data-trade-panel="offers" hidden>
          <div class="wut-trade-offers">
            <div><h3>Incoming Offers</h3><% tradingState.incomingOffers.forEach(offer => { %><article class="wut-trade-offer"><span><strong><%= offer.offered_listing.card.player.name %></strong> for <strong><%= offer.target_listing.card.player.name %></strong></span><small><%= offer.offered_listing.owner_display_name %> offers a <%= titleCase(offer.rarity) %></small><form method="post" action="/cards/trading/respond"><input type="hidden" name="offer_id" value="<%= offer.id %>"><button name="action" value="accept">Accept</button><button class="ghost" name="action" value="decline">Decline</button></form></article><% }) %><% if (!tradingState.incomingOffers.length) { %><p class="muted">No incoming offers.</p><% } %></div>
            <div><h3>Outgoing Offers</h3><% tradingState.outgoingOffers.forEach(offer => { %><article class="wut-trade-offer"><span><strong><%= offer.offered_listing.card.player.name %></strong> for <strong><%= offer.target_listing.card.player.name %></strong></span><small>Waiting on <%= offer.target_listing.owner_display_name %></small><form method="post" action="/cards/trading/respond"><input type="hidden" name="offer_id" value="<%= offer.id %>"><button class="ghost" name="action" value="cancel">Cancel</button></form></article><% }) %><% if (!tradingState.outgoingOffers.length) { %><p class="muted">No outgoing offers.</p><% } %></div>
          </div>
        </section>
      </div>
    </section>
    <dialog id="sellDuplicateDialog" class="wut-trinket-dialog">
      <h2>Sell duplicate?</h2>
      <p><strong data-sell-card-name></strong></p>
      <p class="muted">This permanently removes this extra copy and awards <strong data-sell-card-value></strong> WUT Coins.</p>
      <form method="post" action="/cards/collection/sell-duplicate" class="admin-action-row">
        <input type="hidden" name="card_id" data-sell-card-id>
        <button type="submit">Sell Duplicate</button>
        <button type="button" class="ghost" data-cancel-duplicate-sale>Cancel</button>
      </form>
    </dialog>
    <dialog id="tradeOfferDialog" class="wut-trinket-dialog">
      <h2>Offer trade?</h2>
      <p><strong data-trade-target-name></strong> from <span data-trade-target-owner></span></p>
      <p class="muted">Trades must be 1-for-1 player cards of the same rarity.</p>
      <form method="post" action="/cards/trading/offer" class="wut-trade-offer-form" data-trade-offer-form>
        <input type="hidden" name="target_listing_id" data-trade-target-listing>
        <label>Your listed card
          <select name="offered_listing_id" data-trade-offered-listing required>
            <% tradingState.ownListings.forEach(listing => { %>
              <option value="<%= listing.id %>" data-rarity="<%= listing.rarity %>"><%= titleCase(listing.rarity) %> - <%= listing.card.player.name %></option>
            <% }) %>
          </select>
        </label>
        <div class="admin-action-row">
          <button type="submit">Send Offer</button>
          <button type="button" class="ghost" data-cancel-trade-offer>Cancel</button>
        </div>
      </form>
      <p class="muted" data-no-trade-card hidden>You do not have a listed card of this rarity yet.</p>
    </dialog>
  </main>
  <script>
    const playerCards = [...document.querySelectorAll('[data-collection-panel="players"] .arena-collection-card')];
    const boostCards = [...document.querySelectorAll('[data-collection-panel="boosts"] .collection-boost')];
    const tradeCards = [...document.querySelectorAll('[data-trade-market-card]')];
    const ownTradePanel = document.querySelector('[data-trade-panel="mine"]');
    const ownTradeGrid = document.querySelector('[data-own-trade-grid]');
    const availableTradeGrid = document.querySelector('[data-available-trade-grid]');
    const ownListingCount = document.querySelector('[data-own-listing-count]');
    const availableTradeCount = document.querySelector('[data-available-trade-count]');
    const resultCount = document.querySelector('[data-result-count]');
    const duplicateFilter = document.querySelector('[data-duplicate-filter]');
    const sellDialog = document.getElementById('sellDuplicateDialog');
    const sellCardId = sellDialog?.querySelector('[data-sell-card-id]');
    const sellCardName = sellDialog?.querySelector('[data-sell-card-name]');
    const sellCardValue = sellDialog?.querySelector('[data-sell-card-value]');
    const tradeDialog = document.getElementById('tradeOfferDialog');
    const tradeForm = tradeDialog?.querySelector('[data-trade-offer-form]');
    const tradeTargetListing = tradeDialog?.querySelector('[data-trade-target-listing]');
    const tradeTargetName = tradeDialog?.querySelector('[data-trade-target-name]');
    const tradeTargetOwner = tradeDialog?.querySelector('[data-trade-target-owner]');
    const tradeOfferSelect = tradeDialog?.querySelector('[data-trade-offered-listing]');
    const noTradeCardMessage = tradeDialog?.querySelector('[data-no-trade-card]');
    document.querySelector('[data-cancel-duplicate-sale]')?.addEventListener('click', () => sellDialog.close());
    document.querySelector('[data-cancel-trade-offer]')?.addEventListener('click', () => tradeDialog.close());
    const tradeCountText = (count, label) => `${count} ${label}`;
    const refreshOwnTradeCounts = () => {
      const listed = ownTradeGrid ? ownTradeGrid.querySelectorAll('[data-own-trade-card="listed"]').length : 0;
      const available = availableTradeGrid ? availableTradeGrid.querySelectorAll('[data-own-trade-card="available"]').length : 0;
      if (ownListingCount) ownListingCount.textContent = tradeCountText(listed, 'listed');
      if (availableTradeCount) availableTradeCount.textContent = tradeCountText(available, 'available');
      document.querySelector('[data-trade-empty="listed"]')?.toggleAttribute('hidden', listed > 0);
      document.querySelector('[data-trade-empty="available"]')?.toggleAttribute('hidden', available > 0);
    };
    const insertBeforeEmpty = (grid, card) => {
      const empty = grid?.querySelector('[data-trade-empty]');
      if (empty) grid.insertBefore(card, empty);
      else grid?.appendChild(card);
    };
    const setTradeNotice = (message, error = false) => {
      resultCount.textContent = message;
      resultCount.classList.toggle('error', error);
    };
    const addOwnListingOption = card => {
      if (!tradeOfferSelect || !card.dataset.listingId) return;
      if ([...tradeOfferSelect.options].some(option => option.value === card.dataset.listingId)) return;
      const option = document.createElement('option');
      option.value = card.dataset.listingId;
      option.dataset.rarity = card.dataset.rarity;
      option.textContent = `${card.dataset.rarity.charAt(0).toUpperCase()}${card.dataset.rarity.slice(1)} - ${card.dataset.cardName}`;
      tradeOfferSelect.appendChild(option);
    };
    const removeOwnListingOption = listingId => {
      const option = tradeOfferSelect ? [...tradeOfferSelect.options].find(item => item.value === String(listingId)) : null;
      option?.remove();
    };
    const moveTradeCardToListed = (card, listing) => {
      card.dataset.ownTradeCard = 'listed';
      card.dataset.listingId = listing.id;
      const form = card.querySelector('form');
      form.action = '/cards/trading/unlist';
      form.dataset.tradeUnlistForm = '';
      delete form.dataset.tradeListForm;
      form.innerHTML = `<input type="hidden" name="listing_id" value="${listing.id}"><button class="ghost">Unlist</button>`;
      insertBeforeEmpty(ownTradeGrid, card);
      addOwnListingOption(card);
      refreshOwnTradeCounts();
    };
    const moveTradeCardToAvailable = (card, listingId) => {
      removeOwnListingOption(listingId);
      card.dataset.ownTradeCard = 'available';
      delete card.dataset.listingId;
      const form = card.querySelector('form');
      form.action = '/cards/trading/list';
      form.dataset.tradeListForm = '';
      delete form.dataset.tradeUnlistForm;
      form.innerHTML = `<input type="hidden" name="card_id" value="${card.dataset.cardId}"><button>List for Trade</button>`;
      insertBeforeEmpty(availableTradeGrid, card);
      refreshOwnTradeCounts();
    };
    ownTradePanel?.addEventListener('submit', async event => {
      const form = event.target.closest('form');
      if (!form?.matches('[data-trade-list-form], [data-trade-unlist-form]')) return;
      event.preventDefault();
      const card = form.closest('[data-own-trade-card]');
      const submitButton = form.querySelector('button');
      submitButton.disabled = true;
      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' },
          body: new URLSearchParams(new FormData(form))
        });
        const payload = await response.json();
        if (!response.ok || !payload.ok) throw new Error(payload.error || 'Trade update failed.');
        if (form.matches('[data-trade-list-form]')) {
          moveTradeCardToListed(card, payload.listing);
          setTradeNotice(`${card.dataset.cardName} listed for trading.`);
        } else {
          const listingId = form.querySelector('[name="listing_id"]')?.value;
          moveTradeCardToAvailable(card, listingId);
          setTradeNotice(`${card.dataset.cardName} removed from trading.`);
        }
      } catch (err) {
        setTradeNotice(err.message, true);
        submitButton.disabled = false;
      }
    });
    const openDuplicateSale = card => {
      const value = Number(card.dataset.sellValue || 0);
      if (!value) return false;
      sellCardId.value = card.dataset.cardId;
      sellCardName.textContent = card.dataset.cardName;
      sellCardValue.textContent = value;
      sellDialog.showModal();
      return true;
    };
    playerCards.forEach(card => {
      card.addEventListener('click', () => {
        if (duplicateFilter?.checked && card.dataset.duplicate === '1' && openDuplicateSale(card)) return;
        card.classList.toggle('is-flipped');
      });
      card.addEventListener('keydown', event => {
        if (event.key !== 'Enter' || event.target !== card) return;
        if (duplicateFilter?.checked && card.dataset.duplicate === '1' && openDuplicateSale(card)) return;
        card.classList.toggle('is-flipped');
      });
    });
    const checkedValues = selector => new Set([...document.querySelectorAll(`${selector}:checked`)].map(input => input.value));
    const filterPlayers = () => {
      const editions = checkedValues('[data-edition-filter]');
      const positions = checkedValues('[data-position-filter]');
      const rarity = document.querySelector('[data-rarity-filter]').value;
      const status = document.querySelector('[data-status-filter]')?.value || '';
      const duplicatesOnly = duplicateFilter?.checked || false;
      const search = document.querySelector('[data-card-search]').value.trim().toLowerCase();
      let visible = 0;
      playerCards.forEach(card => {
        const show = editions.has(card.dataset.edition) && positions.has(card.dataset.position) && (!rarity || card.dataset.rarity === rarity) && (!status || card.dataset.status === status) && (!duplicatesOnly || card.dataset.duplicate === '1') && (!search || card.dataset.search.includes(search));
        card.hidden = !show; if (show) visible += 1;
      });
      resultCount.classList.remove('error');
      resultCount.textContent = `${visible} ${duplicatesOnly ? 'duplicate player card' : 'player card'}${visible === 1 ? '' : 's'} shown`;
    };
    const filterBoosts = () => {
      const rarity = document.querySelector('[data-boost-rarity-filter]').value;
      const type = document.querySelector('[data-boost-type-filter]').value;
      const search = document.querySelector('[data-boost-search]').value.trim().toLowerCase();
      let visible = 0;
      boostCards.forEach(boost => {
        const show = (!rarity || boost.dataset.rarity === rarity) && (!type || boost.dataset.type === type) && (!search || boost.dataset.search.includes(search));
        boost.hidden = !show; if (show) visible += 1;
      });
      resultCount.classList.remove('error');
      resultCount.textContent = `${visible} boost${visible === 1 ? '' : 's'} shown`;
    };
    const filterTradeMarket = () => {
      const positions = checkedValues('[data-trade-position-filter]');
      const rarity = document.querySelector('[data-trade-rarity-filter]').value;
      const search = document.querySelector('[data-trade-search]').value.trim().toLowerCase();
      let visible = 0;
      tradeCards.forEach(card => {
        const show = positions.has(card.dataset.position) && (!rarity || card.dataset.rarity === rarity) && (!search || card.dataset.search.includes(search));
        card.hidden = !show; if (show) visible += 1;
      });
      resultCount.classList.remove('error');
      resultCount.textContent = `${visible} trade listing${visible === 1 ? '' : 's'} shown`;
    };
    const openTradeOffer = card => {
      if (!tradeDialog || !tradeOfferSelect) return;
      tradeTargetListing.value = card.dataset.listingId;
      tradeTargetName.textContent = card.dataset.cardName;
      tradeTargetOwner.textContent = card.dataset.owner;
      let available = 0;
      [...tradeOfferSelect.options].forEach(option => {
        const show = option.dataset.rarity === card.dataset.rarity;
        option.hidden = !show;
        option.disabled = !show;
        if (show) available += 1;
      });
      const firstOption = [...tradeOfferSelect.options].find(option => !option.disabled);
      if (firstOption) tradeOfferSelect.value = firstOption.value;
      tradeForm.hidden = !available;
      noTradeCardMessage.hidden = Boolean(available);
      tradeDialog.showModal();
    };
    tradeCards.forEach(card => {
      card.addEventListener('click', () => openTradeOffer(card));
      card.addEventListener('keydown', event => {
        if (event.key !== 'Enter' || event.target !== card) return;
        openTradeOffer(card);
      });
    });
    document.querySelectorAll('[data-filter-panel="players"] input, [data-filter-panel="players"] select').forEach(control => control.addEventListener('input', filterPlayers));
    document.querySelectorAll('[data-filter-panel="boosts"] input, [data-filter-panel="boosts"] select').forEach(control => control.addEventListener('input', filterBoosts));
    document.querySelectorAll('[data-filter-panel="trading"] input, [data-filter-panel="trading"] select').forEach(control => control.addEventListener('input', filterTradeMarket));
    document.querySelectorAll('[data-trade-tab]').forEach(tab => tab.addEventListener('click', () => {
      document.querySelectorAll('[data-trade-tab]').forEach(item => item.classList.toggle('is-active', item === tab));
      document.querySelectorAll('[data-trade-panel]').forEach(panel => panel.hidden = panel.dataset.tradePanel !== tab.dataset.tradeTab);
      if (tab.dataset.tradeTab === 'market') filterTradeMarket();
    }));
    document.querySelectorAll('[data-collection-tab]').forEach(tab => tab.addEventListener('click', () => {
      document.querySelectorAll('[data-collection-tab]').forEach(item => item.classList.toggle('is-active', item === tab));
      document.querySelectorAll('[data-collection-panel], [data-filter-panel]').forEach(panel => panel.hidden = panel.dataset.collectionPanel !== tab.dataset.collectionTab && panel.dataset.filterPanel !== tab.dataset.collectionTab);
      if (tab.dataset.collectionTab === 'players') filterPlayers();
      if (tab.dataset.collectionTab === 'boosts') filterBoosts();
      if (tab.dataset.collectionTab === 'trading') filterTradeMarket();
    }));
    if (window.location.hash === '#trading') document.querySelector('[data-collection-tab="trading"]')?.click();
    else filterPlayers();
  </script>
</body>
</html>
