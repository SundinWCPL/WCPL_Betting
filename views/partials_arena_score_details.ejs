<%
  const fpText = value => {
    const points = Number(value || 0);
    const rounded = Math.round(points * 10) / 10;
    return `${rounded > 0 ? '+' : ''}${rounded} FP`;
  };
  const gameStatLine = (game, position) => {
    const number = value => Number(value || 0);
    if (position === 'G') {
      const shotsAgainst = number(game?.sa);
      const goalsAgainst = number(game?.ga);
      const shutout = number(game?.so) >= 1 || (shotsAgainst > 0 && goalsAgainst === 0) ? 1 : 0;
      return `SV ${Math.max(0, shotsAgainst - goalsAgainst)} · SA ${shotsAgainst} · GA ${goalsAgainst} · SO ${shutout}`;
    }
    return `G ${number(game?.g)} · A ${number(game?.a)} · SH ${number(game?.shots)} · HIT ${number(game?.hits)} · BLK ${number(game?.blocks)}`;
  };
  const rolledGames = row?.rolled_games || row?.synthetic_games || [];
  const rolledGameFps = row?.rolled_game_fps || [];
  const luckyCharm = row?.lucky_charm || null;
  const bonusRollCount = Number(row?.trinket?.effect?.rolls || 0);
  const bonusGames = (row?.bonus_rolled_games || []).slice(0, bonusRollCount);
  const bonusGameFps = (row?.bonus_game_fps || []).slice(0, bonusRollCount);
  const position = row?.card?.player?.position || row?.card_snapshot?.position || '';
  const inferTrinketFamily = label => {
    const text = String(label || '').toLowerCase();
    return [
      ['lucky charm','lucky_charm'], ['safety net','safety_net'], ['glass skates','glass_skates'],
      ['hex charm','hex_bag'], ['warding charm','warding_charm'], ['specialist','specialist_tape'],
      ['first strike','first_strike_tape'], ['counterpunch','counterpunch_gloves'], ['underdog','underdog_patch'],
      ["captain's patch",'team_crest'], ['siphon','siphon_stone'], ['booster cable','booster_cable'],
      ['generalist','generalist'], ['zebra stripes','zebra_stripes']
    ].find(([needle]) => text.includes(needle))?.[1] || '';
  };
%>
<div class="arena-stat-reveal">
  <% (row?.score_breakdown || []).forEach(item => { const basePoints = Number(item.basePoints ?? (item.points - (item.boostBonus || 0))); %>
    <div class="arena-reveal-step" data-user="<%= userId %>" data-points="<%= basePoints %>"><span><%= item.label %><%= item.count == null ? '' : ` - ${item.count}` %><%= item.type === 'save_pct' ? ` (x${Number(item.multiplier || 1).toFixed(2)})` : '' %></span><strong><%= fpText(basePoints) %></strong></div>
    <% if (item.boostBonus) { %><div class="arena-reveal-step is-boost tier-text-<%= row.boost?.rarity %>" data-user="<%= userId %>" data-points="<%= item.boostBonus %>"><span><%= row.boost?.rarity %> <%= row.boost?.boost_type %> Boost</span><strong><%= fpText(item.boostBonus) %></strong></div><% } %>
  <% }) %>
  <% (row?.scoring_effects || []).filter(effect => !String(effect.label || '').startsWith('Journeyman')).forEach(effect => { const family = effect.family || inferTrinketFamily(effect.label); %>
    <div class="arena-reveal-step <%= effect.type === 'trinket' ? `is-trinket tier-text-${effect.rarity || row?.trinket?.rarity || 'common'}` : effect.type === 'boost' ? `is-boost tier-text-${effect.rarity || 'common'}` : '' %>" data-user="<%= userId %>" data-points="<%= Number(effect.points || 0) %>"<% if (family) { %> data-trinket-family="<%= family %>" data-effect-direction="<%= effect.direction || (Number(effect.points || 0) < 0 ? 'incoming' : 'self') %>"<% } %>><span><% if (family) { %><i class="trinket-fx-icon" data-trinket-family="<%= family %>" aria-hidden="true"><%= WUT_TRINKET_ICONS[family] || '◆' %></i><% } %><%= effect.label %></span><strong><%= fpText(effect.points) %></strong></div>
  <% }) %>
</div>
<% if (rolledGames.length) { %>
  <details class="arena-game-rolls">
    <summary>Individual rolled games</summary>
    <div class="arena-game-roll-list">
      <% rolledGames.forEach((game, index) => { const excluded = Boolean(luckyCharm?.hit && Number(luckyCharm.replacedIndex) === index); %>
        <div class="arena-game-roll <%= excluded ? 'is-excluded' : '' %>"><span>Game <%= index + 1 %> · <%= gameStatLine(game, position) %></span><strong><%= fpText(rolledGameFps[index]) %></strong></div>
      <% }) %>
      <% bonusGames.forEach((game, index) => { const included = Boolean(luckyCharm?.hit && Number(luckyCharm.usedBonusIndex) === index); %>
        <div class="arena-game-roll is-bonus <%= included ? '' : 'is-excluded' %>"><span>Lucky Charm roll <%= index + 1 %> · <%= gameStatLine(game, position) %></span><strong><%= fpText(bonusGameFps[index]) %></strong></div>
      <% }) %>
    </div>
  </details>
<% } %>
